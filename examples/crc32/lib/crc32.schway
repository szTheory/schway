module lib.crc32

export {
  fn crc32
}

fn crc32(bytes: ByteView) -> U64 {
  // State stays in the low 32 bits: the seed, input byte, shift, and
  // reflected polynomial all fit there, so each iteration preserves it.
  var crc = 0xFFFFFFFF
  var i = 0
  var n = byte_len(bytes)
  while i < n {
    crc = crc_byte(crc ^ byte_at(bytes, i))
    i = i + 1
  }
  crc = crc ^ 0xFFFFFFFF
  crc
}

fn crc_byte(mixed: U64) -> U64 {
  var state = mixed
  var round = 0
  while round < 8 {
    var next = state >> 1
    if state & 1 == 1 {
      next = next ^ 0xEDB88320
    } else {
      next = state >> 1
    }
    state = next
    round = round + 1
  }
  state
}
