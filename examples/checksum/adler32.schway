// Phase 30 library module (D-06, D-20): pure scalar Adler-32, imported by adler32_cli.schway.
module adler32

export {
  fn adler32
}

fn adler32(bytes: ByteView) -> U64 {
  var a = 1
  var b = 0
  var i = 0
  var n = byte_len(bytes)
  while i < n {
    a = a + byte_at(bytes, i)
    a = a % 65521
    b = b + a
    b = b % 65521
    i = i + 1
  }
  var r = b << 16
  r = r + a
  r
}
