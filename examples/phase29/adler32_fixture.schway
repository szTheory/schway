// Phase 29 test-only fixture owner (D-05, D-09); not the Phase 31 file-bytes owner.
module examples.phase29.adler32_fixture

export {
  fn main
}

foreign C {
  fn schway_fixture_bytes_acquire(case: U64) -> FixtureBytes {
    unwind: forbidden
    nonlocal_exit: forbidden
    mode: "acquire"
    abi: schway_fixture_bytes_acquire_fn
    allocator: "libc_malloc"
    release: "schway_fixture_bytes_release"
    fails: FixtureError
  }

  fn schway_fixture_bytes_view(owner: FixtureBytes) -> ByteView {
    unwind: forbidden
    nonlocal_exit: forbidden
    mode: "borrow"
    abi: schway_fixture_bytes_view_fn
  }

  fn schway_fixture_bytes_release(owner: FixtureBytes) -> Unit {
    unwind: forbidden
    nonlocal_exit: forbidden
    mode: "consume"
    abi: schway_fixture_bytes_release_fn
    allocator: "libc_malloc"
  }
}

data FixtureError =
  | FixtureMissing

fn adler32(bytes: ByteView) -> U64 {
  var a = 1
  var b = 0
  var i = 0
  var n = byte_len(bytes)
  while i < n {
    a = a + byte_at(bytes, i)
    a = a % 65521
    b = b + a
    b = b % 65521
    i = i + 1
  }
  var r = b
  r = r + r
  r = r + r
  r = r + r
  r = r + r
  r = r + r
  r = r + r
  r = r + r
  r = r + r
  r = r + r
  r = r + r
  r = r + r
  r = r + r
  r = r + r
  r = r + r
  r = r + r
  r = r + r
  r = r + a
  r
}

fn main(case: U64) -> U64 {
  let owner = try schway_fixture_bytes_acquire(case)
  let view = schway_fixture_bytes_view(owner)
  let sum = adler32(view)
  sum
}
