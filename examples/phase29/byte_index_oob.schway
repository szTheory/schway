// Phase 29 out-of-bounds control (D-19, D-20): reads one byte past the end of
// the view. The byte-index defect is abort-like: it exits 65 without running
// release, and the operating system reclaims the fixture allocation.
module examples.phase29.byte_index_oob

export {
  fn main
}

foreign C {
  fn schway_fixture_bytes_acquire(case: U64) -> FixtureBytes {
    unwind: forbidden
    nonlocal_exit: forbidden
    mode: "acquire"
    abi: schway_fixture_bytes_acquire_fn
    allocator: "libc_malloc"
    release: "schway_fixture_bytes_release"
    fails: FixtureError
  }

  fn schway_fixture_bytes_view(owner: FixtureBytes) -> ByteView {
    unwind: forbidden
    nonlocal_exit: forbidden
    mode: "borrow"
    abi: schway_fixture_bytes_view_fn
  }

  fn schway_fixture_bytes_release(owner: FixtureBytes) -> Unit {
    unwind: forbidden
    nonlocal_exit: forbidden
    mode: "consume"
    abi: schway_fixture_bytes_release_fn
    allocator: "libc_malloc"
  }
}

data FixtureError =
  | FixtureMissing

fn read_past_end(bytes: ByteView) -> U64 {
  var n = byte_len(bytes)
  var x = byte_at(bytes, n)
  x
}

fn main(case: U64) -> U64 {
  let owner = try schway_fixture_bytes_acquire(case)
  let view = schway_fixture_bytes_view(owner)
  let sum = read_past_end(view)
  sum
}
