module phase23.discard_owner

export {
  fn main
}

foreign C {
  fn lang_file_byte_acquire(path: PathToken) -> FileByteOwner {
    unwind: forbidden
    nonlocal_exit: forbidden
    mode: "acquire"
    abi: lang_file_byte_acquire_fn
    allocator: "libc_malloc"
    release: "lang_file_byte_release"
    fails: AcquireError
  }

  fn lang_file_byte_use(owner: FileByteOwner) -> U64 {
    unwind: forbidden
    nonlocal_exit: forbidden
    mode: "borrow"
    abi: lang_file_byte_use_fn
    fails: UseError
  }

  fn lang_file_byte_release(owner: FileByteOwner) -> Unit {
    unwind: forbidden
    nonlocal_exit: forbidden
    mode: "consume"
    abi: lang_file_byte_release_fn
    allocator: "libc_malloc"
  }
}

data AcquireError =
  | AcquireFailed

data UseError =
  | UnsupportedByte

fn main(path: PathToken) -> U64 {
  discard lang_file_byte_acquire(path) because "discarded owner"
  path
}
