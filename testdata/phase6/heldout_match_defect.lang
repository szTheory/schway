// Held-out match-defect fixture (D-06-25/D-06-29): scored by the CI gate
// only, never consulted when hand-deriving the repair driver's kind->edit
// mapping (06-13's derivation set is derivation_match_defect.lang instead).
// Every arm maps its own alternative to itself, so removing the marked arm
// and reinserting a self-mapping arm for the same alternative reproduces
// this file's match body exactly (D-06-26's byte-identity oracle).
//
// This file also doubles as testdata/phase6's characteristic marker file
// (README), the way testdata/phase5/restrict_borrow.lang does for its own
// corpus.

module phase6.heldout_match_defect

export {
  type Signal
  fn relay
}

data Signal =
  | Red
  | Green
  | Blue

fn relay(state: Signal) -> Signal {
  match state {
    Red => Red
    Green => Green
    Blue => Blue // lang:match-target
  }
}
