// Held-out borrow-defect fixture (D-06-25/D-06-29): scored by the CI gate
// only, never consulted when hand-deriving the repair driver's kind->edit
// mapping (06-13's derivation set is derivation_borrow_defect.schway
// instead). Two overlapping shared loans on one owner are legal; the
// injector escalates the marked one to exclusive, producing exactly the
// overlapping exclusive+shared loan-conflict defect class D-06-25 names.

module phase6.heldout_borrow_defect

export {
  fn relay
}

fn relay(buffer: Buffer) -> borrow(buffer) Buffer {
  let first = borrow buffer
  let second = borrow buffer // schway:borrow-target
  let reviewed = borrow first
  let audited = borrow reviewed
  second
}
