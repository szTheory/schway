// Phase 12 Plan 03, Task 1 (D-12-15's first named refusal): differs from
// testdata/phase12/payload_tracer.lang by adding a third, genuinely
// nullary alternative (`Nope`) and matching the payload-carrying `Ok`
// alternative with NEITHER a pattern binder nor a construction binder --
// `Ok => Nope` instead of `Ok(v) => Ok(v)`.
//
// Because neither side names a place, check.go's fallback (pattern binder,
// else construction binder) resolves to the empty string, and `Ok`
// declares a payload (Buffer) that has nowhere to go: refused as
// check.missing_payload_binder. The other two arms are ordinary and
// contribute no diagnostics, so the refusal is attributable to this one
// arm alone.

module result.payload_missing_binder

export {
  type Fault
  type Outcome
  fn identity
}

data Fault =
  | Broken

data Outcome =
  | Ok(Buffer)
  | Err(Fault)
  | Nope

fn identity(result: Outcome) -> Outcome {
  match result {
    Ok => Nope
    Err(e) => Err(e)
    Nope => Nope
  }
}
