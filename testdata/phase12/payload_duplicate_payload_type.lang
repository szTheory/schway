module result.payload_duplicate_payload_type

export {
  type Outcome
  fn identity
}

data Outcome =
  | Ok(Buffer)
  | Failed(Buffer)

fn identity(result: Outcome) -> Outcome {
  match result {
    Ok(v) => Ok(v)
    Failed(e) => Failed(e)
  }
}
