// Phase 12 Plan 03, Task 1 (D-12-15's second named refusal): differs from
// testdata/phase12/payload_tracer.lang by replacing the second alternative
// (`Err(Fault)`, payload-carrying) with a genuinely nullary alternative,
// `Nope`, and matching it with a pattern binder it has no payload to fill --
// `Nope(x) => Nope` instead of a bare `Nope => Nope`.
//
// Nothing in this data type declares a payload for `Nope`
// (`AlternativeDetail.PayloadType == ""`), so a binder on its pattern is
// refused as check.binder_on_nullary_alternative -- the arm is trying to
// destructure a payload that was never declared.

module result.payload_binder_on_nullary

export {
  type Outcome
  fn identity
}

data Outcome =
  | Ok(Buffer)
  | Nope

fn identity(result: Outcome) -> Outcome {
  match result {
    Ok(v) => Ok(v)
    Nope(x) => Nope
  }
}
