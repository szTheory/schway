// Plan 14-07's own fixture (D-14-45's witness: probe:TestLTOInertnessOnMultiFunctionEmission).
// A multi-function program (2 functions, D-11-14's structural floor, one
// call edge main -> helper) where BOTH functions are Match-bodied with
// arm bodies (lang.core/1 uniformly -- corevalidate requires a bare-arm
// match to be lang.core/0 and an arm-body match to be lang.core/1, and a
// program has exactly one schema, so mixing bare and arm-body match
// functions in one module is not constructible; both functions here use
// arm bodies to stay schema-uniform) -- the exact shape cgen.emitProgram
// refuses outright ("multi-function branch bodies are not supported by
// native emission this phase", cgen_program.go). Entry resolution
// (callgraph.EntryFunction, D-11-05): only `main` calls anything, so
// `helper` is not a root at all (in-degree 1); `main` is the sole
// in-degree-zero root -- no ambiguity.

module phase14.multi_function_match_refusal

export {
  fn main
}

data Switch =
  | Off
  | On

fn helper(state: Switch) -> Switch {
  match state {
    Off => {
      let result = take state
      result
    }
    On => {
      let result = take state
      result
    }
  }
}

fn main(state: Switch) -> Switch {
  match state {
    Off => {
      let result = helper(state)
      result
    }
    On => {
      let result = helper(state)
      result
    }
  }
}
