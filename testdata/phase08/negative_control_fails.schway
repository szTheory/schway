// Phase 08 Task 2(b) -- negative control (D-08-28.4), "fails" member.
// Twin of negative_control_infallible.schway: relay and caller are
// byte-identical to relay_depth2_refuse.schway's own relay/caller pair
// (same declared `-> borrow(buffer) Buffer` signature, same body). The ONLY
// difference between this program and its twin is leaf's OWN Fails/Foreign
// vocabulary: here, leaf wraps a declared, genuinely fallible foreign symbol
// (`fails: ProbeError`, a real allocator/unwind/nonlocal_exit contract);
// relay calls leaf with an ordinary (non-try) "call" binding, exactly as
// 07-12's own call_fallible_foreign_reach.schway shows a caller inheriting a
// callee's published Fails/Foreign transitively without itself needing `try`
// syntax -- so RELAY's own published Fails/ForeignReach differ between this
// program and its twin (relay inherits ProbeError transitively here; leaf's
// contract propagates to relay via originvalidate/corevalidate's own
// closure-join, 07-12), while relay's declared return contract
// (Return.Mode == "shared") and RELAY's own body derivation (a local borrow
// of its own parameter, forwarded to leaf) are UNCHANGED.
//
// The interprocedural loan-liveness law's own consulted-field set is
// {return.mode, parameters[0].mode} only (Task 3's
// interproceduralConsultObserved hook proves this mechanically) -- it never
// reads Fails or ForeignReach at all. Expected: this program produces the
// EXACT SAME verdict as its twin (check.interprocedural_loan_liveness,
// caused by RELAY's own return.mode=shared, identical Detail string modulo
// the module-qualified ID prefix) -- proving the law's silence on
// Fails/ForeignReach isn't an accident of never having varied them, but a
// property demonstrated by actually varying them and observing no verdict
// change (D-08-28.4, "the fields NOT named" half of criterion 4).

module phase08.negative_control_fails

export {
  fn caller
}

foreign C {

  fn leaf_probe(request: Buffer) -> Buffer {
    unwind: forbidden
    nonlocal_exit: forbidden
    allocator: "libc_malloc"
    fails: ProbeError
  }
}

data ProbeError =
  | ProbeFailed

fn leaf(buffer: Buffer) -> Buffer {
  let out = try leaf_probe(buffer)
  out
}

fn relay(buffer: Buffer) -> borrow(buffer) Buffer {
  let borrowed = borrow buffer
  let forwarded = leaf(borrowed)
  forwarded
}

fn caller(buffer: Buffer) -> borrow(buffer) Buffer {
  let borrowed = borrow buffer
  let aliased = relay(borrowed)
  let delivered = take buffer
  aliased
}
