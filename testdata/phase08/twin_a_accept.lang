module phase08.twin_a_accept

export {
  fn escort
}

fn escortee(buffer: Buffer) -> Buffer {
  let taken = take buffer
  taken
}

fn escort(buffer: Buffer) -> Buffer {
  let borrowed = borrow buffer
  let aliased = escortee(borrowed)
  let delivered = take buffer
  aliased
}
