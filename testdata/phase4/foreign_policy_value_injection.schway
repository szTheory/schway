// 04-13 (04-VERIFICATION.md gap 2b, FFI-01): an otherwise ordinary, honest
// program -- identical in every other respect to foreign_acquire_one.lang --
// whose sole `allocator:` policy value carries a comment-terminator payload.
// Before this plan's fix, session.Check admitted this source with ZERO
// diagnostics and cgen.EmitForeignHeader spliced the payload directly into
// the generated header's comment block, escaping the comment and exposing a
// live, uncommented top-level C function definition to the real C compiler
// session.go hands the unit to. This fixture is the honest-source proof that
// the injection channel was reachable from ordinary Lang source text, not
// only from a corrupted core.Program artifact.

module phase4.foreign_policy_value_injection

export {
  fn main
}

foreign C {

  fn lang_res_open(request: Byte) -> Byte {
    unwind: forbidden
    nonlocal_exit: forbidden
    allocator: "*/ int injected(void){return 1;} /*"
    fails: AcquireError
  }
}

data AcquireError =
  | OpenFailed

fn main(request: Byte) -> Byte {
  let handle = try lang_res_open(request)
  handle
}
