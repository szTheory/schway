// D-04-06: a fallible foreign call is admissible only as the operand of
// `try` (or `discard ... because "<rationale>"`, not yet a parsed
// construct). A bare call in a binding right-hand side must not parse --
// syntax.fallible_call_not_consumed, with no core IR encoding ever reached.
module phase4.fallible_call_unconsumed

export {
  fn main
}

foreign C {
  fn lang_res_open(request: Byte) -> Byte {
    unwind: forbidden
    nonlocal_exit: forbidden
    allocator: "libc_malloc"
    fails: AcquireError
  }
}

data AcquireError =
  | OpenFailed

fn main(request: Byte) -> Byte {
  let handle = lang_res_open(request)
  handle
}
