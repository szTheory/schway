// Law under test (D-04-17/D-04-18): the first acquisition of
// schway_nonlocal_probe succeeds and becomes a genuinely live resource; the
// second call to the SAME declared symbol performs a real foreign nonlocal
// exit (native/schway_foreign_nonlocal.c's own frozen, byte-identical
// behavior) instead of ever returning, so the process-root landing pad is
// reached with exactly one still-live acquisition to report as leaked. The
// success and this-step's-own err blocks below are never reached at
// runtime -- the second call never returns locally, ok or err -- but they
// still exist statically so the first acquisition is tracked for release
// exactly like any other resource-lifecycle function (D-04-07).
//
// REACHABILITY (D-04-21/D-10 -- this is a record, not a claim of coverage):
// REACHES: a single declared foreign symbol whose SECOND call within one
// function execution performs a real longjmp back into the process-root
// landing pad, with exactly one prior acquisition genuinely live at that
// moment.
// DOES NOT REACH (accepted residual limitations, T-04-33 -- named here and
// never claimed as covered by any test, comment, fixture, or report in this
// project):
//   1. a landing point established BELOW this pad by a foreign-invoked callback
//      that itself calls setjmp deeper in the call stack;
//   2. a foreign call that terminates the process directly (e.g. exit() /
//      _exit()) rather than performing a nonlocal exit back into
//      Lang-controlled code.
// Neither shape is observable by a single process-root pad; both remain
// accepted residual limitations of this detection mechanism.

module phase4.nonlocal_exit_probe

export {
  fn main
}

foreign C {

  fn schway_nonlocal_probe(request: Byte) -> Byte {
    unwind: forbidden
    nonlocal_exit: possible
    allocator: "libc_malloc"
    fails: ProbeError
  }
}

data ProbeError =
  | ProbeFailed

fn main(request: Byte) -> Byte {
  let handle = try schway_nonlocal_probe(request)
  let trigger = try schway_nonlocal_probe(request)
  request
}
