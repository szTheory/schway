// Law under test (RES-01, D-04-07): of three successive fallible
// acquisitions A, B, C, the SECOND stage's failure block releases only A --
// the one acquisition that had actually completed on the path reaching that
// block -- and releases nothing else, since B (whose own OpForeignCall
// triggered this failure) never completed, and C is never reached at all on
// this path.

module phase4.acquire_three_fail_second

export {
  fn main
}

foreign C {

  fn schway_res_open(request: Byte) -> Byte {
    unwind: forbidden
    nonlocal_exit: forbidden
    allocator: "libc_malloc"
    fails: AcquireError
  }
}

data AcquireError =
  | OpenFailed

fn main(request: Byte) -> Byte {
  let a = try schway_res_open(request)
  let b = try schway_res_open(request)
  let c = try schway_res_open(request)
  request
}
