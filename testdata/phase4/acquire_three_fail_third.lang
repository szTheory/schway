// Law under test (RES-01, D-04-07): of three successive fallible
// acquisitions A, B, C, the THIRD stage's failure block releases B then A --
// in the reverse of their completed-acquisition order -- since both A and B
// had completed on the path reaching this block, while C (whose own
// OpForeignCall triggered this failure) never completed and is therefore
// never released.

module phase4.acquire_three_fail_third

export {
  fn main
}

foreign C {

  fn lang_res_open(request: Byte) -> Byte {
    unwind: forbidden
    nonlocal_exit: forbidden
    allocator: "libc_malloc"
    fails: AcquireError
  }
}

data AcquireError =
  | OpenFailed

fn main(request: Byte) -> Byte {
  let a = try lang_res_open(request)
  let b = try lang_res_open(request)
  let c = try lang_res_open(request)
  request
}
