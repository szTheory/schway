// CTL-02 source witness: the terminal match uses a Result returned by a
// Lang callee, rather than the function's input place.
module phase18.result_computed_match

export {
  fn main
}

data Resource =
  | Raw

data Result =
  | Accepted
  | Rejected

fn produce(value: Resource) -> Result {
  let computed = value
  match computed {
    Raw => Accepted
  }
}

fn main(input: Resource) -> Result {
  let result = produce(input)
  match result {
    Accepted => Accepted
    Rejected => Rejected
  }
}
