// CTL-03 source witness: a computed Outcome is matched, its payload is
// destructured, reconstructed into the selected alternative, and returned.
module phase18.payload_return

export {
  type Outcome
  fn return_payload
}

data Outcome =
  | Ok(Buffer)
  | Again(Byte)

fn return_payload(value: Outcome) -> Outcome {
  let result = take value
  match result {
    Ok(payload) => Ok(payload)
    Again(other) => Again(other)
  }
}
