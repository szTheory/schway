// Phase 13 Plan 04 Task 2 -- D-13-28's criterion-3 twin pair, MIRROR
// half. Byte-for-byte the same shared-callee/two-caller/depth-2-relay
// topology as heldout_shared_callee_twin_alpha.schway, with the marker
// (and therefore the depth-2 relay chain from `main`) moved from
// `alpha` to `beta` -- a real structural difference, not an
// alpha-renaming: the reachable, mutated, detection-bearing function is
// a DIFFERENT declaration than in the alpha half. `alpha` here carries
// no marker and is never mutated.
//
// This is the control D-13-28 requires: a blame rule that always
// answers with a fixed function (e.g. "the first caller declared", or
// "whichever caller is named alpha") would be right on the alpha half
// by construction and wrong here, and a rule that always answers with
// the callee (`sink`) fails BOTH halves outright once a genuine
// caller-local fix is verified against either one (13-05/13-06 wires
// that verification once wrap_call_in_try's sibling repairs exist).
// This plan's own obligation is the same as the alpha half's: base
// checks clean unmutated, injector run against the marked caller
// produces exactly one check.interprocedural_loan_liveness diagnostic
// (D-13-26.3), and the marked caller sits at root-to-detection hop
// distance 2 from `main` (D-13-26.2).

module phase13.heldout_shared_callee_twin_mirror

export {
  fn main
}

fn sink(buffer: Buffer) -> Buffer {
  let held = take buffer
  held
}

fn alpha(buffer: Buffer) -> Buffer {
  let borrowed = borrow buffer
  let routed = sink(borrowed)
  let delivered = take buffer
  routed
}

fn beta(buffer: Buffer) -> Buffer {
  let borrowed = borrow buffer
  let routed = sink(borrowed)
  let delivered = take buffer // schway:interprocedural-loan-target
  routed
}

fn relay(buffer: Buffer) -> Buffer {
  let out = beta(buffer)
  out
}

fn main(buffer: Buffer) -> Buffer {
  let out = relay(buffer)
  out
}
