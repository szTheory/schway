// Phase 13 Plan 04 Task 2 -- held-out member of the fallible-consume
// class (D-13-09 Set A class 2). Scored ONLY by a future CI-gate driver
// (testdata/phase13/README); NEVER read by hand when deriving the
// wrap_call_in_try repair's edit -- see derivation_fallible_call_
// unconsumed.schway for that.
//
// Topology varies by CALL-GRAPH DEPTH, not by identifier (D-13-25): the
// marked `try` call lives inside `acquire`, reached from `main` through
// two Lang-to-Lang hops (`main` -> `relay` -> `acquire`), so
// root-to-detection hop distance is 2 -- the derivation member's is 0
// (D-13-26.1/D-13-26.2). function count 3, call-edge count 3 (main->
// relay, relay->acquire, acquire's own foreign try_call).
// TestCorpusTopologyDisjoint re-derives this triple independently over
// ast.Program and asserts it differs from derivation's.
//
// Base checks clean unmutated (D-13-26.3); FallibleConsumeInjector
// strips " try" from the marked line, reproducing exactly one
// syntax.fallible_call_not_consumed diagnostic.

module phase13.heldout_fallible_call_unconsumed

export {
  fn main
}

foreign C {

  fn schway_res_open(request: Byte) -> Byte {
    unwind: forbidden
    nonlocal_exit: forbidden
    allocator: "libc_malloc"
    fails: AcquireError
  }
}

data AcquireError =
  | OpenFailed

fn acquire(request: Byte) -> Byte {
  let handle = try schway_res_open(request) // schway:fallible-consume-target
  handle
}

fn relay(request: Byte) -> Byte {
  let opened = acquire(request)
  opened
}

fn main(request: Byte) -> Byte {
  let result = relay(request)
  result
}
