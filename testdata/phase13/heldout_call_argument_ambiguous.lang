// Phase 13 Plan 04 Task 2 -- held-out AMBIGUOUS member of the
// call-argument-mismatch class (D-13-09 Set A class 3, D-13-10's
// required positive test). Unlike heldout_call_argument_mismatch.lang
// and derivation_call_argument_mismatch.lang, this fixture is not part
// of TestCorpusTopologyDisjoint's paired comparison (no
// derivation_call_argument_ambiguous.lang exists -- this fixture has no
// "easy" counterpart, it demonstrates a THIRD sub-case of the same
// class). It has its own required properties instead: a prior `let`
// (`spare = value`, a plain copy -- Byte carries AbilityCopy) sits in
// scope BEFORE the mismatched call, per 13-RESEARCH.md Pitfall 3 --
// because every place in a Lang function shares one constructor, this
// gives TWO initialized places of the same type (`value` and `spare`)
// once CallArgumentTypeInjector flips `identity`'s declared type,
// exactly the "2+ matches" shape D-13-10's future uniqueness gate must
// REFUSE to repair (`unrepairable`), not the "exactly 1 match" shape
// derivation/heldout_call_argument_mismatch.lang give it.
//
// Root-to-detection hop distance 2 (`main` -> `relay` -> `dispatch`,
// matching heldout_call_argument_mismatch.lang's own depth so this
// fixture is equally "hard", D-13-26.2). This plan does not yet assert
// the future repair's unrepairable outcome (that lands with the repair
// itself in 13-05/13-06) -- TestHeldoutBaselinesAreFailClosed only
// asserts the D-13-26.3 baseline: clean unmutated, exactly one
// diagnostic mutated.

module phase13.heldout_call_argument_ambiguous

export {
  fn main
}

fn identity(value: Byte) -> Byte { // lang:call-argument-target
  value
}

fn dispatch(value: Byte) -> Byte {
  let spare = value
  let result = identity(value)
  result
}

fn relay(value: Byte) -> Byte {
  let forwarded = dispatch(value)
  forwarded
}

fn main(value: Byte) -> Byte {
  let done = relay(value)
  done
}
