// Phase 13 Plan 03 Task 1 -- D-13-23's falsifiable fixture for function
// attribution: a real, three-function interprocedural chain (caller ->
// relay -> leaf, the same shape as testdata/phase08/relay_depth2_refuse.schway)
// with a DECOY function (`decoy`) whose byte range lies between two of the
// visited functions (leaf and relay) in source order. Every function here
// checks cleanly on its own; only `caller`'s own admission produces
// check.interprocedural_loan_liveness (borrow buffer -> call relay, which
// interprocedurally extends the loan -> take buffer before relay's own
// call is genuinely the loan's last use), so `check.Program`'s per-function
// loop appends EVERY function -- including the unrelated decoy -- to
// core.Program.Functions before the interprocedural pass ever runs
// (check.go's `if len(result.Diagnostics) == 0` gate).
//
// Same-package session tests (session_phase6_explain_test.go) parse and
// check this fixture directly to obtain a real, fully-populated function
// table (four real functions, real non-overlapping spans, a genuine decoy
// in the middle) and drive buildExplainGraph with synthetic causes located
// at hand-picked spans inside each function body -- no existing check.go
// diagnostic today naturally produces a Cause whose Span crosses a function
// boundary (13-RESEARCH.md Pitfall 2), so the fixture's job is to supply
// real, checkable multi-function span data for the resolver itself to be
// tested against, exactly as this file's own established convention
// (TestExplainRespectsDepthAndNodeBudget and friends) already constructs
// synthetic diagnostic.Diagnostic values against real span shapes.

module phase13.explain_three_function_chain

export {
  fn caller
}

fn leaf(buffer: Buffer) -> borrow(buffer) Buffer {
  let observed = borrow buffer
  observed
}

fn decoy(value: Byte) -> Byte {
  value
}

fn relay(buffer: Buffer) -> borrow(buffer) Buffer {
  let borrowed = borrow buffer
  let forwarded = leaf(borrowed)
  forwarded
}

fn caller(buffer: Buffer) -> borrow(buffer) Buffer {
  let borrowed = borrow buffer
  let aliased = relay(borrowed)
  let delivered = take buffer
  aliased
}
