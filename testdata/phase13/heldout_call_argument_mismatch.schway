// Phase 13 Plan 04 Task 2 -- held-out member of the call-argument-
// mismatch class (D-13-09 Set A class 3). Scored ONLY by a future
// CI-gate driver; NEVER read by hand when deriving the
// use_matching_argument repair's edit (testdata/phase13/README) -- see
// derivation_call_argument_mismatch.lang for that.
//
// Topology varies by CALL-GRAPH DEPTH (D-13-25): the marked call lives
// inside `dispatch`, reached from `main` through two Lang-to-Lang hops
// (`main` -> `relay` -> `dispatch`), so root-to-detection hop distance
// is 2 -- the derivation member's is 0. function count 4, call-edge
// count 3. `dispatch`'s own call is still its FIRST binding, so only
// `value` is in scope when CallArgumentTypeInjector flips `identity`'s
// declared type -- exactly one initialized place matches (unlike
// heldout_call_argument_ambiguous.lang, which puts a prior `let` in
// scope so two places match). TestCorpusTopologyDisjoint re-derives the
// (function count, call-edge count, hop distance) triple independently
// over ast.Program and asserts it differs from derivation's, and that
// this fixture's own hop distance is >= 2 (D-13-26.2).
//
// Base checks clean unmutated (D-13-26.3); CallArgumentTypeInjector
// flips `identity`'s declared Byte to Buffer, reproducing exactly one
// check.call_argument_type_mismatch diagnostic at `dispatch`'s call
// site.

module phase13.heldout_call_argument_mismatch

export {
  fn main
}

fn identity(value: Byte) -> Byte { // lang:call-argument-target
  value
}

fn dispatch(value: Byte) -> Byte {
  let result = identity(value)
  result
}

fn relay(value: Byte) -> Byte {
  let forwarded = dispatch(value)
  forwarded
}

fn main(value: Byte) -> Byte {
  let done = relay(value)
  done
}
