// Multi-arm origin leak control fixture (03-VERIFICATION.md SC3/SC4 gaps,
// 03-REVIEW.md CR-01 renumbered): a match-bodied function whose FIRST arm
// returns an owned value and whose SECOND arm returns a live, unreleased
// shared borrow of the parameter. originvalidate.RecomputeOrigin used to
// walk backward from only the first core.OpReturn in a function's flat
// Operations list; check.go's arm lowering appends one OpReturn per arm
// into that same list, so the second arm's borrow-derived return was
// invisible and this program exported with no public_origin field at all,
// indistinguishable from a fully-owned return. `schway check` accepts this
// program unchanged; `lang interface export` must refuse it with
// core.origin_omitted.

module owned.public_view_multi_arm_omitted

export {
  type Switch
  fn choose
}

data Switch =
  | On
  | Off

fn choose(flag: Switch) -> Switch {
  match flag {
    On => {
      let moved = take flag
      moved
    }
    Off => {
      let view = borrow flag
      view
    }
  }
}
