// The same shape as branch_one_arm_shared_accept.lang, but the mutation is
// reachable from the BORROWING arm's own edge: the "On" arm moves flag
// while its own loan is still live. Rejected with the ordinary
// move_while_borrowed diagnostic, whose cause chain names the loan; the
// sibling "Off" arm is untouched and would be legal on its own.

module owned.branch_one_arm_shared_reject

export {
  type Switch
  fn choose
}

data Switch =
  | On
  | Off

fn choose(flag: Switch) -> Switch {
  match flag {
    On => {
      let view = borrow flag
      let moved = take flag
      view
    }
    Off => {
      let held = take flag
      held
    }
  }
}
