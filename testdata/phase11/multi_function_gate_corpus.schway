// Phase 11 mid-phase gate corpus (D-11-14, PLAN.md plan 11-04 Task 2). This
// program is deliberately engineered to make the gate NON-VACUOUS:
//
//   - Three functions (>= 2, D-11-14's structural floor).
//   - One call edge, `main` -> `identity` (>= 1, the second structural
//     floor).
//   - `touch` is the WOULD-HAVE-CARRIED-RESTRICT function: its body is the
//     exact structural shape testdata/phase5/restrict_borrow.schway uses --
//     an exclusive borrow of the sole Buffer parameter as the FIRST
//     operation, never referenced again directly, with every remaining
//     operation forming one unbroken reborrow chain to the function's own
//     OpReturn terminator. cgen.SelectsByPointerLowering (equivalently,
//     session's own independent re-derivation, phase11WouldCarryRestrict)
//     returns true for `touch` alone -- neither `main` nor `identity`
//     match this shape, since neither borrows its Byte parameter at all.
//     `touch` is declared but never called from `main`, so it is the
//     gate's own engineered "would have carried restrict, but doesn't
//     appear in the actual multi-function call graph" witness.
//
// Entry resolution (callgraph.EntryFunction, D-11-05): `touch` and `main`
// are both in-degree-zero roots (nothing calls either), but `main`'s own
// reachable closure ({identity}, size 1) is strictly larger than `touch`'s
// (empty, size 0), so `main` resolves as the unique entry -- no ambiguity.

module phase11.multi_function_gate_corpus

export {
  fn main
}

fn identity(value: Byte) -> Byte {
  value
}

fn main(value: Byte) -> Byte {
  let result = identity(value)
  result
}

fn touch(buffer: Buffer) -> Buffer {
  let first = borrow mut buffer
  let second = borrow first
  let third = borrow second
  third
}
