// SEM-06's negative control (D-07-34): `main` calls `relay`, whose body is
// the identical shape to testdata/phase07/clean_but_unpublishable.schway's own
// `relay` -- it checks clean on its own (zero diagnostics from
// session.Check), but fails publication with core.origin_omitted, so
// originvalidate.PublishProblemsFor reports Callable == false for it. The
// call is refused because `relay` is NOT PUBLISHABLE -- a publication-safety
// failure (D-04-03, D-07-31, D-07-32) -- NOT because it is unexported. An
// unexported-callee fixture would be the WRONG negative control here: it
// would test a rule D-04-03 never stated (D-07-31b). `relay` is declared
// exported below specifically to make that distinction unmistakable: this
// refusal fires with export membership held constant.
//
// A cross-module copy of this callee already exists as
// testdata/phase07/clean_but_unpublishable.schway; it is repeated here (module
// line and caller aside) because calls in this phase resolve only within a
// single parsed program (D-07-01) -- there is no cross-module call channel
// yet for `main` to reach that file's `relay` directly.

module phase07.call_uncallable_callee

export {
  fn relay
  fn main
}

fn relay(buffer: Buffer) -> Buffer {
  let view = borrow mut buffer
  let reviewed = borrow view
  view
}

fn main(buffer: Buffer) -> Buffer {
  let result = relay(buffer)
  result
}
