// 07-REVIEW.md IN-02's standing witness: a caller reaching TWO callees
// whose published `Fails` values DISAGREE (`ErrA` vs `ErrB`), so
// joinFails' documented, disclosed non-order-independence (D-07-53 --
// the accumulator always wins over a later disagreeing value) is
// actually exercised, not merely a same-value no-op join. This fixture
// exists so a Go test can assert `main`'s published `Fails` is the SAME
// value whether read from `originvalidate.BuildInterface` (the producer)
// or `corevalidate.Validate`'s independently-derived peer signature --
// producer/peer parity for `Fails` under a genuinely disagreeing,
// order-sensitive join, not just the identity/equal-merge cases
// call_fallible_foreign_reach.lang already covers.
//
// This fixture checks and corevalidates clean; it is a witness about a
// published FIELD's value, not a refusal fixture.

module phase07.call_two_fallible_callees_disagree

export {
  fn main
}

foreign C {

  fn probe_a(request: Byte) -> Byte {
    unwind: forbidden
    nonlocal_exit: forbidden
    allocator: "libc_malloc"
    fails: ErrA
  }

  fn probe_b(request: Byte) -> Byte {
    unwind: forbidden
    nonlocal_exit: forbidden
    allocator: "libc_malloc"
    fails: ErrB
  }
}

data ErrA =
  | ErrAFailed

data ErrB =
  | ErrBFailed

fn tracer_a(value: Byte) -> Byte {
  let result = try probe_a(value)
  result
}

fn tracer_b(value: Byte) -> Byte {
  let result = try probe_b(value)
  result
}

fn main(value: Byte) -> Byte {
  let first = tracer_a(value)
  let second = tracer_b(first)
  second
}
