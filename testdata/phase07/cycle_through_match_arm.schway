// D-07-28: a cycle whose CLOSING edge originates INSIDE a match arm.
// call_from_both_match_arms.lang (07-04) proved enumerate-by-kind-across-
// all-blocks on the ADMISSION path; this fixture proves the same property
// on the REFUSAL path -- the Phase-12 blindness guard made real without
// `Result` payloads. `main` and `helper` are both arm-bodied match
// functions (a module cannot mix a match-bodied function with a
// straight-line one -- core.mixed_body_versions).

module phase07.cycle_through_match_arm

export {
  fn main
}

data Choice =
  | A
  | B

fn helper(value: Choice) -> Choice {
  match value {
    A => {
      let result = main(value)
      result
    }
    B => {
      value
    }
  }
}

fn main(flag: Choice) -> Choice {
  match flag {
    A => {
      let result = helper(flag)
      result
    }
    B => {
      flag
    }
  }
}
