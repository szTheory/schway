// The A/B control paired with call_argument_used_twice.schway, proving the
// refusal there is about the SECOND use of a non-copyable call argument,
// not about passing a Buffer to a call at all. Same callee, same argument
// type, but `buffer` is passed to exactly ONE call -- checks clean.

module phase07.call_argument_used_once

export {
  fn main
}

fn identity(value: Buffer) -> Buffer {
  value
}

fn main(buffer: Buffer) -> Buffer {
  let result = identity(buffer)
  result
}
