// SEM-07 (D-07-17/D-07-18): a call graph whose calls form a cycle is
// refused with a named refusal code, never a hang -- never a native-
// recursion stack overflow. Fixtures are named by cycle length: this one
// is length 2 (mutual recursion). cycle_self (length 1) and cycle_indirect
// (length >= 3, landing in 07-07) are the only other names; there is no
// cycle_direct.schway, the superseded name.

module phase07.cycle_mutual

export {
  fn a
}

fn b(value: Byte) -> Byte {
  let result = a(value)
  result
}

fn a(value: Byte) -> Byte {
  let result = b(value)
  result
}
