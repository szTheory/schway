// adversarial-target: allocator-mismatch-dynamic
//
// D-05-08: this program's own static contract layer is untouched -- it
// declares `allocator: "libc_malloc"` for `schway_arena_open`, and check.go/
// corevalidate's release_allocator_mismatch refusal continues to compare
// only that DECLARED string against its own paired auto-generated release,
// which can never disagree with itself (T-04-14). The DYNAMIC defect lives
// entirely inside native/schway_foreign_arena.c's real C implementation: the
// frozen TU actually allocates via posix_memalign (a real, different
// physical allocator identity from schway_foreign_resource.c's plain
// malloc) and releases via the mismatched operator-delete entry point --
// a genuine allocator-identity mismatch the STATIC declared-string check
// cannot see, because it never inspects the real C implementation behind
// a declared symbol. This is exactly the "generated binding is a
// candidate contract, never proof" boundary. Detection is ASan's own
// alloc-dealloc-mismatch diagnostic, reached only through
// lane:native-sanitize (RunSanitized) -- never a bare native run.

module phase5.allocator_mismatch

export {
  fn main
}

foreign C {

  fn schway_arena_open(request: Byte) -> Byte {
    unwind: forbidden
    nonlocal_exit: forbidden
    allocator: "libc_malloc"
    fails: ArenaError
  }
}

data ArenaError =
  | ArenaOpenFailed

fn main(request: Byte) -> Byte {
  let handle = try schway_arena_open(request)
  request
}
