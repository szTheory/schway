// adversarial-target: typed-failure-with-truncated-stdout
//
// D-05-18a: a long chain of 150 successive foreign acquisitions, all of
// which the frozen production TU genuinely succeeds at real runtime
// (D-04-10), while a test-only foreign double used elsewhere in this
// phase's own harness (session_phase5_corpus_test.go, peering
// session_test.go's own writeFailingForeignDouble/assertTypedFailurePathAgrees
// pattern) fails exactly the LAST stage, taking the err edge and releasing
// every one of the 149 preceding completed acquisitions in reverse
// order before the typed failure. 150 acquisitions plus 149 releases
// plus one failure is enough distinct semantic events that the generated
// native binary's own real stdout -- the strict-JSON execution document
// every one of those events is serialized into -- crosses the project's
// existing 64 KiB-plus-one stdout bound (D-05-18), exercising the stable
// stage/stream truncation code as a genuinely compared axis rather than an
// assumed one. Every one of the 150 stages is independent and unread
// (D-05-18a's own dead-store shape, repeated 150 times), so this fixture
// also stresses the same optimizer surface dead_store_unused_acquire.schway
// and reorder_two_events.schway name individually, at a scale neither of
// those two-and-under-sized fixtures reaches.

module phase5.typed_failure_truncated_stdout

export {
  fn main
}

foreign C {

  fn schway_res_open(request: Byte) -> Byte {
    unwind: forbidden
    nonlocal_exit: forbidden
    allocator: "libc_malloc"
    fails: AcquireError
  }
}

data AcquireError =
  | OpenFailed

fn main(request: Byte) -> Byte {
  let v0 = try schway_res_open(request)
