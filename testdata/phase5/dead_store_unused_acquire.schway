// adversarial-target: dead-store-elimination-of-unused-borrowed-acquire
//
// D-05-18a: a single foreign acquisition whose OWN acquired value is never
// read on the success path -- the binding `handle` is written and dropped,
// the function returns its own untouched parameter instead -- while the
// acquisition's release is still an OBSERVABLE compared event and a
// live-resource-ledger entry (D-05-20). An optimizer legally free to prove
// `handle` dead could eliminate the write to it; the release call itself,
// and the events it produces, must still occur, so a dead-store-eliminating
// `-O3`/LTO build must still agree with the interpreter and `-O0` on the
// full event sequence and live-resource ledger, not merely the terminal
// value.

module phase5.dead_store_unused_acquire

export {
  fn main
}

foreign C {

  fn schway_res_open(request: Byte) -> Byte {
    unwind: forbidden
    nonlocal_exit: forbidden
    allocator: "libc_malloc"
    fails: AcquireError
  }
}

data AcquireError =
  | OpenFailed

fn main(request: Byte) -> Byte {
  let handle = try schway_res_open(request)
  request
}
