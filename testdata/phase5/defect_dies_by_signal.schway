// adversarial-target: defect-terminating-by-signal
//
// D-05-18a: a real, reachable, deliberately terminal `defect`, peering
// testdata/phase4/defect_terminal.lang's own shape (a new file per this
// phase's own corpus, D-05-18, not a fork of the Phase 4 fixture): the
// "Halt" arm aborts the process directly from a match arm with no call
// surface at all, giving D-05-20's added "exit status and signal" compared
// axis a real subject -- a defect-terminated process exits by raising
// SIGABRT, a genuinely NEW axis this phase's differential (D-05-19/D-05-20)
// must agree on across the interpreter, `-O0`, and `-O3` alike, which the
// existing Phase 1-4 corpus never exercised as a compared field. The "Go"
// arm is an ordinary returning arm, proving the same function's non-defect
// path is unaffected.

module phase5.defect_dies_by_signal

export {
  type Signal
  fn triage
}

data Signal =
  | Go
  | Halt

fn triage(flag: Signal) -> Signal {
  match flag {
    Go => {
      let held = take flag
      held
    }
    Halt => {
      defect "adversarial defect: dies by signal"
    }
  }
}
