     1	// Package corevalidate independently validates inert typed-core facts before
     2	// an execution engine consumes them. It intentionally does not know source or
     3	// reuse checker/interpreter authorization code.
     4	package corevalidate
     5	
     6	import (
     7		"encoding/json"
     8		"fmt"
     9		"reflect"
    10		"sort"
    11	
    12		"github.com/codename-lang/lang/internal/compiler/core"
    13	)
    14	
    15	const maxTypeDepth = 64
    16	
    17	// KnownEscape names the exact boundary this validator cannot prove. A producer
    18	// that coordinates a false source claim with internally consistent core facts
    19	// remains outside source-blind validation.
    20	const KnownEscape = "escape:coordinated-source-core-lie"
    21	
    22	// LinearWorkLimit is the exact declared count for the canonical scale shape:
    23	// one sealed Byte fact, one parameter plus one target per copy, and facts-1
    24	// copies followed by one final return claim.
    25	//
    26	// The +1 over the pre-03-04 formula (16*facts+13) is loanChainIndex's own
    27	// honest, once-per-place counted work (D-05): every operation in this scale
    28	// shape reads from the SAME parameter place (never a derived one), so
    29	// carriedLoans visits exactly one NEW place — the parameter itself — no
    30	// matter how large facts grows, and memoizes it after that single visit.
    31	// The constant is therefore facts-independent by construction, not an
    32	// unaccounted bump: TestValidatorReborrowChainIsLinear separately proves the
    33	// chain-walk's own cost scales with chain depth when the scale shape
    34	// actually has one to walk.
    35	func LinearWorkLimit(facts int) int { return 16*facts + 14 }
    36	
    37	type Problem struct {
    38		Code   string `json:"code"`
    39		Detail string `json:"detail,omitempty"`
    40	}
    41	
    42	type Result struct {
    43		Valid    bool      `json:"valid"`
    44		Problems []Problem `json:"problems,omitempty"`
    45		Checks   int       `json:"checks"`
    46		program  core.Program
    47	}
    48	
    49	// Program returns a content-owned copy of the validated program. Callers can
    50	// neither mutate the validator's copy nor race validation by retaining slices.
    51	func (r Result) Program() core.Program { return cloneProgram(r.program) }
    52	
    53	// Validate is deliberately source-blind. It proves internal consistency of a
    54	// typed-core statement, not that a coordinated producer translated source
    55	// truthfully.
    56	func Validate(input core.Program) Result {
    57		owned := cloneProgram(input)
    58		v := validator{program: owned}
    59		v.run()
    60		return Result{Valid: len(v.problems) == 0, Problems: v.problems, Checks: v.checks, program: owned}
    61	}
    62	
    63	type validator struct {
    64		program  core.Program
    65		checks   int
    66		problems []Problem
    67	}
    68	
    69	func (v *validator) check(ok bool, code, detail string) bool {
    70		v.checks++
    71		if ok {
    72			return true
    73		}
    74		if len(v.problems) == 0 {
    75			v.problems = append(v.problems, Problem{Code: code, Detail: detail})
    76		}
    77		return false
    78	}
    79	
    80	func (v *validator) run() {
    81		if !v.check(v.program.Schema == core.Schema || v.program.Schema == core.Schema1, "core.schema", v.program.Schema) {
    82			return
    83		}
    84		if !v.check(v.program.Module != "" && v.program.ModuleID != "", "core.module", "missing module identity") {
    85			return
    86		}
    87		if !v.check(len(v.program.Functions) > 0, "core.function_missing", v.program.ModuleID) {
    88			return
    89		}
    90		dataNames := make(map[string]core.DataType, len(v.program.DataTypes))
    91		dataIDs := make(map[string]struct{}, len(v.program.DataTypes))
    92		for _, dataType := range v.program.DataTypes {
    93			if !v.unique(dataIDs, dataType.ID, "core.duplicate_type_id") || !v.check(dataType.Name != "", "core.unknown_type", dataType.ID) {
    94				return
    95			}
    96			if _, exists := dataNames[dataType.Name]; !v.check(!exists, "core.duplicate_type_name", dataType.Name) {
    97				return
    98			}
    99			alternatives := make(map[string]struct{}, len(dataType.Alternatives))
   100			for _, alternative := range dataType.Alternatives {
   101				if !v.unique(alternatives, alternative, "core.duplicate_alternative") {
   102					return
   103				}
   104			}
   105			dataNames[dataType.Name] = dataType
   106		}
   107		functionIDs := make(map[string]struct{}, len(v.program.Functions))
   108		for index := range v.program.Functions {
