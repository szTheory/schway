598:func Check(source []byte) CheckResult {
    70	// the execution document is causally derived from the C runtime state.
    71	type OwnedBackendMutationRunner struct {
    72		runner        native.Runner
    73		mu            sync.Mutex
    74		optimizations []string
    75	}
    76	
    77	func NewOwnedBackendMutationRunner(runner native.Runner) *OwnedBackendMutationRunner {
    78		return &OwnedBackendMutationRunner{runner: runner}
    79	}
    80	
    81	// mutationMarker is the stable generated seam cgen emits at the single
    82	// owned-transfer value site (D-02-07). Locating the mutation by this marker,
    83	// rather than the previous exact source-derived line
    84	// ("LANG_BUFFER lang_value_delivered = ... op:0"), means renaming a fixture
    85	// binding or reindenting the emitter cannot silently turn this control into
    86	// an opaque operational failure — the seam survives both. The fail-closed
    87	// exact-one requirement is unchanged: the marker must appear on exactly one
    88	// line, or the control refuses to run rather than mutating an ambiguous or
    89	// absent site.
    90	const mutationMarker = "/* lang:mutation-site */"
    91	
    92	func (r *OwnedBackendMutationRunner) Run(ctx context.Context, cSource, optimization string, inputs []string) (native.Result, error) {
    93		lines := strings.Split(cSource, "\n")
    94		matched := -1
    95		for index, line := range lines {
    96			if strings.Contains(line, mutationMarker) {
    97				if matched != -1 {
    98					return native.Result{}, &native.ToolError{Code: "native.backend_control_invalid", Err: fmt.Errorf("owned transfer mutation marker count is >1, want 1")}
    99				}
   100				matched = index
   101			}
   102		}
   103		if matched == -1 {
   104			return native.Result{}, &native.ToolError{Code: "native.backend_control_invalid", Err: fmt.Errorf("owned transfer mutation marker count is 0, want 1")}
   105		}
   106		mutatedLine := lines[matched] + "\n  lang_value_delivered.bytes[0] ^= 0xffu; /* control: backend runtime causality */"
   107		lines[matched] = mutatedLine
   108		mutated := strings.Join(lines, "\n")
   109		r.mu.Lock()
   110		r.optimizations = append(r.optimizations, optimization)
   111		r.mu.Unlock()
   112		return r.runner.Run(ctx, mutated, optimization, inputs)
   113	}
