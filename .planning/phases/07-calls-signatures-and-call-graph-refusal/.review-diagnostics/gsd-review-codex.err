   461	// tryCallBinding parses `try <callee>(<arg>, ...)` following a binding's `=`
   462	// (D-04-06's sole admissible fallible-call consumer this phase).
   463	func (p *parser) tryCallBinding(bindingStart, name Token) (ast.Binding, int) {
   464		tryToken := p.advance()
   465		callee := p.identifier("syntax.expected_foreign_callee")
   466		arguments, end := p.callArguments()
   467		rhs := ast.RHS{Kind: "try_call", Callee: callee.Text, Arguments: arguments, Span: spanFrom(tryToken, callee)}
   468		return ast.Binding{Name: name.Text, RHS: rhs, Span: diagnostic.Span{Start: bindingStart.Span.Start, End: end}}, end
   469	}
   470	
   471	// discardBecause parses `discard <callee>(<arg>, ...) because "<rationale>"`
   472	// (D-04-06's second and only other admissible fallible-call consumer). The
   473	// rationale is a required non-empty string literal; an empty or absent
   474	// rationale is a parse-level rejection, so the core IR never has to encode a
   475	// discard whose rationale is missing.
   125	
   126	type LinearBody struct {
   127		Bindings []Binding
   128		Result   string
   129		// DefectReason is populated instead of Result when this body's terminal
   130		// position is `defect "<reason>"` (D-04-15): a real, reachable, abort-only
   131		// terminal outcome. Exactly one of Result and DefectReason is ever
   132		// populated for any given body.
   133		DefectReason string
   134		Span         diagnostic.Span
   135	}
   136	
   137	type Binding struct {
   138		Name string
   139		RHS  RHS
   140		Span diagnostic.Span
   141	}
   142	
   143	type RHS struct {
   144		Kind   string
   145		Source string
   146		Span   diagnostic.Span
   147		// Callee and Arguments are populated when Kind == "try_call" or
   148		// Kind == "discard_call" (D-04-06): a fallible foreign call, admissible
   149		// only as the operand of `try` or `discard ... because`. Callee names
   150		// the foreign symbol; Arguments is its argument place names in source
   151		// order.
   152		Callee    string
   153		Arguments []string
   154		// Rationale is populated only when Kind == "discard_call": the required
   155		// non-empty string literal explaining why the call's failure is not
   156		// actionable here (D-04-06). Empty for every other Kind.
   157		Rationale string
   158	}
   245		for _, kind := range core.AllOperationKinds() {
   246			all[kind] = true
   247		}
   248		for _, kind := range core.TerminatorKinds() {
   249			if !all[kind] {
   250				t.Fatalf("terminator kind %q is not in AllOperationKinds()", kind)
   251			}
   252		}
   253	}
