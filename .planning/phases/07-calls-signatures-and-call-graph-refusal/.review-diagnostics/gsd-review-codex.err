   829	func (v *validator) loanEndpointsMatch(function *core.Function) bool {
   830		recomputed := v.recomputeLoanEndpoints(function)
   831		return v.check(reflect.DeepEqual(recomputed, function.Linear.LoanEndpoints), "core.loan_endpoint_mismatch", function.ID)
   832	}
   833	
   834	func (v *validator) replay(function *core.Function, types map[string]core.TypeFact, places map[string]core.Place) bool {
   835		if len(function.Linear.Blocks) > 0 {
   836			return v.replayBlocks(function, types, places)
   837		}
   838		return v.replayStraightLine(function, types, places)
   839	}
   840	
   841	func (v *validator) replayStraightLine(function *core.Function, types map[string]core.TypeFact, places map[string]core.Place) bool {
   842		operations := function.Linear.Operations
   843		operationsByID := make(map[string]core.LinearOperation, len(operations))
   844		for _, operation := range operations {
   845			operationsByID[operation.ID] = operation
   846		}
   847		initialized := map[string]bool{function.Parameter.ID: true}
   848		produced := map[string]bool{function.Parameter.ID: true}
   849		loanOwner := make(map[string]string)
   850		// loanLastUse is transitive: a place produced from a loan-derived place
   851		// carries every loan its source carried. Recording only the immediate
   852		// borrow target lets a reborrow or a copy of a loan expire the original
   853		// loan one operation early and admit a move while it is still observable.
   854		// D-02-03/Q2(b), validator half: this used to re-copy a place's whole
   855		// loan-ancestry list on every operation (a per-operation append-and-copy
   856		// that grows with chain depth). loanChainIndex.carriedLoans replaces
   857		// that with a memoized parent-pointer chain walked at most once per
   858		// place across the whole function.
   859		loanLastUse := make(map[string]int)
   860		chain := buildLoanChainIndex(operations, &v.checks)
   861		for index, operation := range operations {
   862			v.checks++ // inspect each operation once while finding final loan uses
   863			for _, loanID := range chain.carriedLoans(operation.SourceID) {
   864				loanLastUse[loanID] = index
   865			}
   866			if operation.Kind == core.OpBorrowShared || operation.Kind == core.OpBorrowExclusive {
   867				loanOwner[operation.LoanID] = operation.SourceID
   868				loanLastUse[operation.LoanID] = index
   869			}
   870		}
   871		ownerBlockedUntil := make(map[string]int)
   872		for loanID, ownerID := range loanOwner {
   873			v.checks++ // consolidate each declared loan exactly once
   874			if loanLastUse[loanID] > ownerBlockedUntil[ownerID] {
   875				ownerBlockedUntil[ownerID] = loanLastUse[loanID]
   876			}
   877		}
   878		// ownerLiveSharedUntil/ownerLiveExclusiveUntil independently re-derive
   879		// the five-row conflict matrix (T-03-07): unlike ownerBlockedUntil (a
   880		// single whole-function aggregate, used only for the move-while-
   881		// borrowed law, which is safe because a place can never be re-borrowed
   882		// after it is moved), these two maps are updated incrementally in
   883		// program order as pass 2 below encounters each new loan, so a loan
   884		// created later in the function can never appear to "block" an earlier
   885		// one. This is a materially different mechanism from check.go's
   886		// per-owner active-loan set with immediate per-index expiry (D-12): it
   887		// derives conflict from an aggregated running high-water mark per
   888		// access mode, not from a checker-shaped set of currently-live loan
   889		// objects.
   890		ownerLiveSharedUntil := make(map[string]int)
   891		ownerLiveExclusiveUntil := make(map[string]int)
   892	
   893		returned := false
   894		for index, operation := range operations {
   895			source := places[operation.SourceID]
   896			if !v.check(source.TypeID == operation.TypeID, "core.type_mismatch", operation.ID) {
   897				return false
   898			}
   899			if !v.check(initialized[operation.SourceID], finalOrTransitionCode(operation.Kind), operation.SourceID) {
   900				return false
   901			}
   902			v.checks++ // dispatch one independently authorized transition
   903			switch operation.Kind {
   904			case core.OpCopy:
   905				if !v.check(hasAbility(types[operation.TypeID], core.AbilityCopy), "core.ability.copy_denied", operation.TypeID) {
   906					return false
   907				}
   908				if !v.targetMatches(function, index, operation, places, produced) {
   909					return false
   910				}
   911				initialized[operation.TargetID] = true
   912				produced[operation.TargetID] = true
   913			case core.OpBorrowShared:
   914				if !v.check(hasAbility(types[operation.TypeID], core.AbilityShare), "core.ability.share_denied", operation.TypeID) {
   915					return false
   916				}
   917				if until, blocked := ownerLiveExclusiveUntil[operation.SourceID]; !v.check(!blocked || until < index, "core.borrow_conflict", operation.ID) {
   918					return false
   919				}
   920				if !v.targetMatches(function, index, operation, places, produced) {
   921					return false
   922				}
   923				initialized[operation.TargetID] = true
   924				produced[operation.TargetID] = true
   925				if lastUse := loanLastUse[operation.LoanID]; lastUse > ownerLiveSharedUntil[operation.SourceID] {
   926					ownerLiveSharedUntil[operation.SourceID] = lastUse
   927				}
   928			case core.OpBorrowExclusive:
   929				if !v.check(hasAbility(types[operation.TypeID], core.AbilityShare), "core.ability.share_denied", operation.TypeID) {
   930					return false
   931				}
   932				sharedUntil, sharedBlocked := ownerLiveSharedUntil[operation.SourceID]
   933				exclusiveUntil, exclusiveBlocked := ownerLiveExclusiveUntil[operation.SourceID]
   934				conflict := (sharedBlocked && sharedUntil >= index) || (exclusiveBlocked && exclusiveUntil >= index)
   935				if !v.check(!conflict, "core.borrow_conflict", operation.ID) {
   936					return false
   937				}
   938				if !v.targetMatches(function, index, operation, places, produced) {
   939					return false
   940				}
   941				initialized[operation.TargetID] = true
   942				produced[operation.TargetID] = true
   943				if lastUse := loanLastUse[operation.LoanID]; lastUse > ownerLiveExclusiveUntil[operation.SourceID] {
   944					ownerLiveExclusiveUntil[operation.SourceID] = lastUse
   945				}
   946			case core.OpMove:
   947				blockedUntil, hasLoan := ownerBlockedUntil[operation.SourceID]
   948				if !v.check(!hasLoan || blockedUntil < index, "core.move_while_borrowed", operation.ID) {
   949					return false
   950				}
   951				if !v.targetMatches(function, index, operation, places, produced) {
   952					return false
   953				}
   954				initialized[operation.SourceID] = false
   955				initialized[operation.TargetID] = true
   956				produced[operation.TargetID] = true
   957			case core.OpReturn:
   958				if index != len(operations)-1 || returned || operation.TargetID != "" || operation.TypeID != source.TypeID || types[source.TypeID].Shape.Constructor != function.ReturnType {
   959					return v.check(false, "core.final_claim_mismatch", operation.ID)
   960				}
   961				returned = true
   962			case core.OpForeignCall:
   963				if !v.targetMatches(function, index, operation, places, produced) {
   964					return false
   965				}
   966				initialized[operation.TargetID] = true
   967				produced[operation.TargetID] = true
   968				errTarget, errKnown := places[operation.ErrTargetID]
   969				if !v.check(errKnown && operation.ErrTargetID != operation.TargetID && operation.ErrTargetID != operation.SourceID && !produced[operation.ErrTargetID] && errTarget.TypeID != "", "core.invalid_target", operation.ErrTargetID) {
   970					return false
   971				}
   972				initialized[operation.ErrTargetID] = true
   973				produced[operation.ErrTargetID] = true
   974			case core.OpFail:
   975				if !v.check(index == len(operations)-1 && !returned && operation.TargetID == "", "core.final_claim_mismatch", operation.ID) {
   976					return false
   977				}
   978				returned = true
   979			case core.OpDefect:
   980				// A terminator alongside OpReturn/OpFail (D-04-15): never the
   981				// last operation of anything but its own straight-line body (this
   982				// case exists only so control:kind.exhaustive_dispatch's table
   983				// finds it handled here too -- a straight-line, block-less body
   984				// can never actually carry a defect this phase).
   985				if !v.check(index == len(operations)-1 && !returned && operation.TargetID == "" && operation.Reason != "", "core.final_claim_mismatch", operation.ID) {
   986					return false
   987				}
   988				returned = true
   989			case core.OpRelease:
   990				// A non-terminal transition (D-04-07): it discharges an
   991				// already-produced acquisition and produces no new place. The
   992				// reverse-order release sequence itself is independently
   993				// rederived and compared in checkReleaseOrder, not here --
