    96	
    97	func (e *pathCapError) Error() string {
    98		return fmt.Sprintf("pathoracle.path_count_exceeded: function %q exceeds the declared cap of %d acyclic entry-to-return paths", e.functionID, e.limit)
    99	}
   100	
   101	// Code reports the stable diagnostic code for a path-count-cap rejection.
   102	func (e *pathCapError) Code() string { return "pathoracle.path_count_exceeded" }
   103	
   104	// PathCapError type-asserts err as the path-count-cap rejection, mirroring
