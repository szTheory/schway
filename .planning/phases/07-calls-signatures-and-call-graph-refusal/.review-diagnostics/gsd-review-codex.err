   404	func digest(data []byte) string {
   405		sum := sha256.Sum256(data)
   406		return "sha256:" + hex.EncodeToString(sum[:])
   407	}
   408	
   409	// BuildInterface strips every function body from program and binds the
   410	// resulting summary to program's own content digest, reusing the same
   411	// SHA-256 content-digest pattern already proven for evidence.CoreDigest
   412	// (Spike 004's certificate binds the same way). Callers MUST run
   413	// ValidatePublished against program first: BuildInterface packages what the
   414	// producer already proved rather than re-deriving it.
   415	func BuildInterface(program core.Program) (core.Interface, error) {
   416		coreBytes, err := json.Marshal(program)
   417		if err != nil {
   418			return core.Interface{}, err
   419		}
   420		summary := core.Interface{
   421			Schema: core.InterfaceSchema, ModuleID: program.ModuleID, CoreDigest: digest(coreBytes),
   422			Functions: make([]core.FunctionSignature, 0, len(program.Functions)),
   423		}
   424		for _, function := range program.Functions {
   425			abilities := []core.Ability{}
   426			if function.Linear != nil {
   427				for _, fact := range function.Linear.Types {
   428					if fact.ID == function.ID+":type:0" {
   429						abilities = fact.Abilities
   430						break
   431					}
   432				}
   433			}
   434			summary.Functions = append(summary.Functions, core.FunctionSignature{
   435				ID: function.ID, Name: function.Name, Parameter: function.Parameter, ReturnType: function.ReturnType,
   436				PublicOrigin: function.PublicOrigin, Abilities: abilities,
   437			})
   438		}
   439		return summary, nil
   440	}
   441	
   442	// FunctionAnswer is what a body-blind consumer can decide for one function:
   443	// its declared origin and access mode, read directly from the summary.
   444	type FunctionAnswer struct {
   445		ID     string
   446		Name   string
   447		Paths  []string
   448		Access string
   449	}
   450	
   451	// CheckSummary is the body-blind consuming path (OWN-04 success criterion
   452	// 4's second, independent CLI invocation). coreBytes is the RAW, UNPARSED
   453	// bytes of the core artifact the summary claims to be bound to: this
   454	// function hashes them and compares against the summary's recorded digest,
   455	// and NEVER unmarshals coreBytes into any struct that could carry a
   456	// Linear/Match body field — the digest check is the only use coreBytes is
   457	// put to, and it runs before any origin or access question is answered
   458	// (T-03-03: a stale summary is rejected before it is partially trusted).
   459	func CheckSummary(summaryBytes, coreBytes []byte) ([]FunctionAnswer, error) {
   460		var summary core.Interface
   461		if err := json.Unmarshal(summaryBytes, &summary); err != nil {
   462			return nil, &Error{Code: "origin.invalid_summary"}
   463		}
   464		if summary.CoreDigest != digest(coreBytes) {
   465			return nil, &Error{Code: "origin.stale_summary"}
   466		}
   467		answers := make([]FunctionAnswer, 0, len(summary.Functions))
   468		for _, function := range summary.Functions {
   469			answer := FunctionAnswer{ID: function.ID, Name: function.Name}
   470			if function.PublicOrigin != nil {
   471				answer.Paths = function.PublicOrigin.Paths
   472				answer.Access = function.PublicOrigin.Access
   473			}
   474			answers = append(answers, answer)
   475		}
   476		return answers, nil
   477	}
