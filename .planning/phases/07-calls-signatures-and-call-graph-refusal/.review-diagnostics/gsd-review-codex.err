   390	// understated.
   391	func containsAll(declared, recomputed []string) bool {
   392		present := make(map[string]bool, len(declared))
   393		for _, path := range declared {
   394			present[path] = true
   395		}
   396		for _, path := range recomputed {
   397			if !present[path] {
