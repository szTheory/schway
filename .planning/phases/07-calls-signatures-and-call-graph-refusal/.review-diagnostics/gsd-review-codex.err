   608		if result.Work > MaxCheckWork {
   609			result.Diagnostics = append(result.Diagnostics, diagnostic.Error("check.work_limit", diagnostic.Span{}, "checking exceeds the declared work limit"))
   610			return result
   611		}
   612		result.Program = checked.Program
   613		result.Diagnostics = append(result.Diagnostics, checked.Diagnostics...)
   614		return result
   615	}
