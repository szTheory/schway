   430			})
   431			body.Span.End = source.Span.End
   432		}
   433		if p.peek().Kind == TokenDefect {
   434			// D-04-15: `defect "<reason>"` is the other admissible terminal form
   435			// alongside a bare Result identifier -- a real, reachable, abort-only
   436			// terminal outcome needing no call surface. The reason is a required
   437			// non-empty string literal, exactly like discard's own rationale.
   438			start := p.advance()
   439			reasonToken := p.expect(TokenString, "syntax.expected_defect_reason")
   440			reason := reasonToken.Text
   441			if len(reason) >= 2 && reasonToken.Kind == TokenString {
   442				reason = reason[1 : len(reason)-1]
   443			}
   444			if reason == "" {
   445				p.problem("syntax.defect_reason_empty", reasonToken, "defect requires a non-empty reason string")
   446			}
   447			body.DefectReason = reason
   448			end := reasonToken.Span.End
   449			if start.Kind != TokenDefect {
   450				end = start.Span.End
   451			}
   452			body.Span.End = end
   453			return body
   454		}
   455		result := p.identifier("syntax.expected_linear_result")
   456		body.Result = result.Text
   457		body.Span.End = result.Span.End
   458		return body
   459	}
