    17	func Run(program core.Program, functionName, input string) (Execution, error) {
    18		validated := corevalidate.Validate(program)
    19		if !validated.Valid {
    20			return Execution{}, fmt.Errorf("core validation failed: %s", validated.Problems[0].Code)
    21		}
    22		program = validated.Program()
    23		function, ok := findFunction(program, functionName)
    24		if !ok {
    25			return Execution{}, fmt.Errorf("function %q is absent from checked core", functionName)
    26		}
    27		if !function.HasClosedBody() {
    28			return Execution{}, fmt.Errorf("function %q has invalid body union", functionName)
    29		}
    30		if function.Linear != nil && function.Match == nil {
    31			return runLinear(function, input)
    32		}
    33		for _, arm := range function.Match.Arms {
    34			if arm.Pattern != input {
    35				continue
    36			}
    37			if arm.BlockID == "" {
    38				event := Event{
    39					Schema: Schema, ID: arm.ID + ":event:returned", Kind: "function.returned",
    40					FunctionID: function.ID, Input: input, Output: arm.Value,
    41				}
    42				return Execution{
    43					Schema: Schema, Outcome: Outcome{Kind: "returned", Value: arm.Value},
    44					Events: []Event{event}, LiveResources: []string{},
    45				}, nil
    46			}
    47			return runBranchArm(function, arm, input)
    48		}
    49		return Execution{}, fmt.Errorf("checked match %q has no arm for %q", function.Match.ID, input)
    50	}
    51	
    52	// runBranchArm walks only the operations of the selected arm's block, in
    53	// core order, and emits their events — the D-12a consumer this phase adds
    54	// alongside check, corevalidate, and cgen. The unselected arms' operations
    55	// are never visited, so they produce no events (03-01-02's behavior clause).
    56	func runBranchArm(function core.Function, arm core.MatchArm, input string) (Execution, error) {
    57		var block core.Block
    58		found := false
    59		for _, candidate := range function.Linear.Blocks {
    60			if candidate.ID == arm.BlockID {
    61				block, found = candidate, true
    62				break
    63			}
    64		}
    65		if !found {
    66			return Execution{}, fmt.Errorf("branch arm %q references unknown block %q", arm.ID, arm.BlockID)
    67		}
    68		operations := make(map[string]core.LinearOperation, len(function.Linear.Operations))
    69		for _, operation := range function.Linear.Operations {
    70			operations[operation.ID] = operation
    71		}
    72		values := map[string]string{function.Parameter.ID: input}
    73		events := make([]Event, 0, len(block.OperationIDs))
    74		for _, operationID := range block.OperationIDs {
    75			operation, known := operations[operationID]
    76			if !known {
    77				return Execution{}, fmt.Errorf("block %q references unknown operation %q", block.ID, operationID)
    78			}
    79			value, initialized := values[operation.SourceID]
    80			if !initialized {
    81				return Execution{}, fmt.Errorf("operation %q reads uninitialized place %q", operation.ID, operation.SourceID)
    82			}
    83			switch operation.Kind {
    84			case core.OpCopy:
    85				values[operation.TargetID] = value
    86				events = append(events, ownedEvent(function, operation, "value.copied"))
    87			case core.OpMove:
    88				delete(values, operation.SourceID)
    89				values[operation.TargetID] = value
    90				events = append(events, ownedEvent(function, operation, "value.transferred"))
    91			case core.OpBorrowShared:
    92				values[operation.TargetID] = value
    93				events = append(events, ownedEvent(function, operation, "value.borrowed"))
    94			case core.OpBorrowExclusive:
    95				values[operation.TargetID] = value
    96				events = append(events, ownedEvent(function, operation, "value.borrowed_exclusive"))
    97			case core.OpForeignCall:
    98				// No match arm can produce a foreign call this phase (checkBranch
    99				// does not admit `try` inside an arm body) -- this case exists
   100				// solely so control:kind.exhaustive_dispatch's six-site table
   101				// finds every kind handled at every site, per D-04-22.
   102				values[operation.TargetID] = value
   103				values[operation.ErrTargetID] = "err"
   104				events = append(events, Event{
   105					Schema: execution.Schema1, ID: operation.ID + ":event", Kind: "foreign.called", FunctionID: function.ID,
   106					SourcePlace: operation.SourceID, TargetPlace: operation.TargetID, TypeID: operation.TypeID,
   107				})
