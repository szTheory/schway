   164	// DebugMapSummary is the `debug-map` command projection.
   165	type DebugMapSummary struct {
  1015	
  1016	// MaxInterfaceBytes bounds the two new Phase 3 (OWN-04) untrusted input
  1017	// surfaces this command family reads: a published interface summary and the
  1018	// raw core artifact bytes a `interface check` invocation binds it against.
  1019	// Sized like evidence.MaxManifestBytes — both are small, bounded JSON
  1020	// artifacts, not source.
  1021	const MaxInterfaceBytes = 1 << 21
  1022	
  1023	// InterfaceExportCommandFile is the producer side of OWN-04's separate
  1024	// compilation demonstration: it checks sourcePath, independently recomputes
  1025	// every declared PublicOrigin fact from the typed core alone
  1026	// (originvalidate.ValidatePublished — T-03-02/T-03-16), and only on success
  1027	// writes a body-stripped, digest-bound core.Interface summary to outPath.
  1028	func InterfaceExportCommandFile(sourcePath, outPath string) (protocol.Result, error) {
  1029		started := time.Now()
  1030		source, err := readBoundedFile(sourcePath, syntax.MaxSourceBytes)
  1031		if err != nil {
  1032			return protocol.Result{}, err
  1033		}
  1034		checked := Check(source)
  1035		result := protocol.New("interface", protocol.StatusPass)
  1036		if len(checked.Diagnostics) > 0 {
  1037			result.Status = protocol.StatusInvalid
  1038			result.Diagnostics = checked.Diagnostics
  1039			return completeCommand(result, started, checked.Work), nil
  1040		}
  1041		validated := corevalidate.Validate(checked.Program)
  1042		if !validated.Valid {
  1043			return protocol.Result{}, fmt.Errorf("core validation failed: %s", validated.Problems[0].Code)
  1044		}
  1045		checked.Program = validated.Program()
  1046		if problems := originvalidate.ValidatePublished(checked.Program); len(problems) > 0 {
  1047			result.Status = protocol.StatusInvalid
  1048			result.Diagnostics = []diagnostic.Diagnostic{diagnostic.Error(problems[0].Code, diagnostic.Span{}, problems[0].Detail)}
  1049			return completeCommand(result, started, checked.Work), nil
  1050		}
  1051		summary, err := originvalidate.BuildInterface(checked.Program)
  1052		if err != nil {
  1053			return protocol.Result{}, err
  1054		}
  1055		summaryBytes, err := json.Marshal(summary)
  1056		if err != nil {
  1057			return protocol.Result{}, err
  1058		}
  1059		if err := os.WriteFile(outPath, append(summaryBytes, '\n'), 0o600); err != nil {
  1060			return protocol.Result{}, err
  1061		}
  1062		result.Interface = interfaceProjection(summary.Schema, summary.ModuleID, summary.CoreDigest, summary.Functions)
  1063		result.ExpectedEscapes = originvalidate.ExpectedEscapes()
  1064		return completeCommand(result, started, len(summary.Functions)), nil
  1065	}
  1066	
  1067	// InterfaceCoreCommandFile writes the exact checked-and-validated core.Program
  1068	// bytes for sourcePath to outPath — the same bytes InterfaceExportCommandFile
  1069	// digests into a summary's CoreDigest. A real build pipeline already retains
  1070	// this artifact from `lang check`; this command exists so the two-invocation
  1071	// separate-compilation demonstration (export, then check) has a standalone
  1072	// way to obtain the core artifact a summary is bound to, without requiring
  1073	// `interface check` itself to reconstruct or re-derive it.
  1074	func InterfaceCoreCommandFile(sourcePath, outPath string) (protocol.Result, error) {
  1075		started := time.Now()
  1076		source, err := readBoundedFile(sourcePath, syntax.MaxSourceBytes)
  1077		if err != nil {
  1078			return protocol.Result{}, err
  1079		}
  1080		checked := Check(source)
  1081		result := protocol.New("interface", protocol.StatusPass)
  1082		if len(checked.Diagnostics) > 0 {
  1083			result.Status = protocol.StatusInvalid
  1084			result.Diagnostics = checked.Diagnostics
  1085			return completeCommand(result, started, checked.Work), nil
  1086		}
  1087		validated := corevalidate.Validate(checked.Program)
  1088		if !validated.Valid {
  1089			return protocol.Result{}, fmt.Errorf("core validation failed: %s", validated.Problems[0].Code)
  1090		}
  1091		program := validated.Program()
  1092		coreBytes, err := json.Marshal(program)
  1093		if err != nil {
  1094			return protocol.Result{}, err
  1095		}
  1096		// Written byte-for-byte with no appended newline: this is exactly the
  1097		// digest preimage originvalidate.BuildInterface hashes into a summary's
  1098		// CoreDigest, so a byte a consumer reads back here must match precisely.
  1099		if err := os.WriteFile(outPath, coreBytes, 0o600); err != nil {
  1100			return protocol.Result{}, err
  1101		}
  1102		result.ModuleID = program.ModuleID
  1103		return completeCommand(result, started, len(program.Functions)), nil
  1104	}
  1105	
  1106	// InterfaceCheckCommandFile is the consumer side of OWN-04's separate
  1107	// compilation demonstration: a genuinely separate CLI invocation that
  1108	// answers origin/access questions from summaryPath alone. coreBytesPath's
  1109	// content is hashed (via originvalidate.CheckSummary) and compared against
  1110	// the summary's recorded digest and is NEVER decoded as a core.Program — the
  1111	// consuming path never touches a body field, by construction, not by
  1112	// discipline.
  1113	func InterfaceCheckCommandFile(summaryPath, coreBytesPath string) (protocol.Result, error) {
  1114		started := time.Now()
  1115		summaryBytes, err := readBoundedFile(summaryPath, MaxInterfaceBytes)
  1116		if err != nil {
  1117			return protocol.Result{}, err
  1118		}
  1119		coreBytes, err := readBoundedFile(coreBytesPath, MaxInterfaceBytes)
  1120		if err != nil {
  1121			return protocol.Result{}, err
  1122		}
  1123		answers, checkErr := originvalidate.CheckSummary(summaryBytes, coreBytes)
  1124		result := protocol.New("interface", protocol.StatusPass)
  1125		if checkErr != nil {
  1126			result.Status = protocol.StatusInvalid
  1127			code := "origin.invalid_summary"
  1128			var originError *originvalidate.Error
  1129			if errors.As(checkErr, &originError) {
  1130				code = originError.Code
  1131			}
  1132			result.Diagnostics = []diagnostic.Diagnostic{diagnostic.Error(code, diagnostic.Span{}, "interface summary rejected")}
  1133			return completeCommand(result, started, 1), nil
  1134		}
  1135		var summary core.Interface
  1136		if err := json.Unmarshal(summaryBytes, &summary); err != nil {
  1137			return protocol.Result{}, err
  1138		}
  1139		functions := make([]protocol.InterfaceFunctionAnswer, 0, len(answers))
  1140		for _, answer := range answers {
  1141			functions = append(functions, protocol.InterfaceFunctionAnswer{ID: answer.ID, Name: answer.Name, Paths: answer.Paths, Access: answer.Access})
  1142		}
  1143		result.Interface = &protocol.InterfaceSummary{Schema: summary.Schema, ModuleID: summary.ModuleID, CoreDigest: summary.CoreDigest, Functions: functions}
  1144		result.ExpectedEscapes = originvalidate.ExpectedEscapes()
  1145		return completeCommand(result, started, len(answers)), nil
  1146	}
  1147	
  1148	// DebugMapCommandFile is the CLI seam for the bounded debug-lineage
  1149	// experiment (D-01..D-04, Task 03-07-01): it checks and validates sourcePath
  1150	// exactly like `check`, then joins the honestly-checked source and core
  1151	// artifacts via debugmap.Build. When query is non-empty, the result contains
  1152	// only the single resolved entry for that operation ID (debugmap.Resolve),
  1153	// proving the honest-absence report through the shipped binary rather than
  1154	// only in-process; an empty query returns the full joined map.
  1155	func DebugMapCommandFile(path, query string) (protocol.Result, error) {
  1156		started := time.Now()
  1157		source, err := readBoundedFile(path, syntax.MaxSourceBytes)
  1158		if err != nil {
  1159			return protocol.Result{}, err
  1160		}
  1195		if query != "" {
  1196			entries = []debugmap.Entry{debugmap.Resolve(built, query)}
  1197		}
  1198		protocolEntries := make([]protocol.DebugMapEntry, 0, len(entries))
  1199		for _, entry := range entries {
  1200			protocolEntries = append(protocolEntries, protocol.DebugMapEntry{
  1201				ID: entry.ID, CoreID: entry.CoreID, OperationID: entry.OperationID, PointID: entry.PointID,
  1202				Kind: entry.Kind, Availability: string(entry.Availability),
  1203			})
  1204		}
  1205		result.DebugMap = &protocol.DebugMapSummary{Schema: built.Schema, Entries: protocolEntries}
  1206		return completeCommand(result, started, work), nil
  1207	}
  1208	
  1209	func interfaceProjection(schema, moduleID, coreDigest string, functions []core.FunctionSignature) *protocol.InterfaceSummary {
  1210		summary := &protocol.InterfaceSummary{Schema: schema, ModuleID: moduleID, CoreDigest: coreDigest, Functions: make([]protocol.InterfaceFunctionAnswer, 0, len(functions))}
  1211		for _, function := range functions {
  1212			answer := protocol.InterfaceFunctionAnswer{ID: function.ID, Name: function.Name}
  1213			if function.PublicOrigin != nil {
  1214				answer.Paths = function.PublicOrigin.Paths
  1215				answer.Access = function.PublicOrigin.Access
  1216			}
  1217			summary.Functions = append(summary.Functions, answer)
  1218		}
  1219		return summary
  1220	}
  1221	
  1222	func readBoundedFile(path string, limit int) ([]byte, error) {
  1223		file, err := os.Open(path)
  1224		if err != nil {
  1225			return nil, err
  1226		}
  1227		defer file.Close()
  1228		return io.ReadAll(io.LimitReader(file, int64(limit)+1))
  1229	}
  1230	
  1231	func commandProblem(command, status, code, message string) protocol.Result {
  1232		result := protocol.New(command, status)
  1233		result.Diagnostics = []diagnostic.Diagnostic{diagnostic.Error(code, diagnostic.Span{}, message)}
  1234		return result.Finalize()
  1235	}

