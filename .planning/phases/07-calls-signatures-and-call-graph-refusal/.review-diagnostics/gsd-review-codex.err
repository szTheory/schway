    64		NonlocalExit string `json:"nonlocal_exit,omitempty"`
    65		Fails        string `json:"fails,omitempty"`
    66		// InitializedState, Capture, Retention, and Aliasing are Phase 4 plan 03's
    67		// remaining FFI-01 obligation categories (D-04-12). This phase's language
    68		// has no partial-field initialization, no closures, no threads, and no
    69		// calls into Lang, so all four are structurally fixed facts the compiler
    70		// derives identically for every declared symbol (check.go's
    71		// standardForeignObligations) rather than per-symbol declarations.
    72		// Capture/Retention/Aliasing are additionally named in the lang.foreign/0
    73		// sidecar manifest's unchecked_obligations list (D-04-12c), since nothing
    74		// in this phase exercises them.
    75		InitializedState string `json:"initialized_state,omitempty"`
    76		Capture          string `json:"capture,omitempty"`
    77		Retention        string `json:"retention,omitempty"`
    78		Aliasing         string `json:"aliasing,omitempty"`
    79		// Layout is the target record layout obligation (D-04-12/T-04-14): an
    80		// ordered field list with declared size, alignment, and offset, plus the
    81		// record's own declared size and alignment. This phase's foreign surface
    82		// has exactly one declared record shape (the {ok, value} two-field
    83		// by-value ABI result cgen's emitLinearForeign always generates), so
    84		// every foreign symbol's Layout is currently checker-derived -- a fixed
    85		// structural fact, not a per-symbol declaration (see check.go's
    86		// standardForeignLayout).
    87		Layout *RecordLayout `json:"layout,omitempty"`
    88		// Alias is Phase 4 plan 06's additive omitempty fact (D-04-28/FFI-01): a
    89		// declared foreign symbol's own aliasing obligation toward the return
    90		// value it produces on its ok edge. "" (the default) means the returned
