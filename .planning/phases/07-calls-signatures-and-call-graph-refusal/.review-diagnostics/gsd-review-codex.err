   266	// TestAllOperationKindsHandledAtEverySite is the control:kind.exhaustive_dispatch
   267	// table (D-04-22): for every existing OperationKind, drive real programs
   268	// containing that kind through check (session.Check), corevalidate,
   269	// interp, cgen, pathoracle, and originvalidate, and assert none of them
   270	// reject or crash. Every declared kind must be exercised by at least one
   271	// fixture, so a kind that no corpus program ever produces cannot silently
   272	// pass this control by omission.
   273	//
   274	// pathoracle and originvalidate do not switch exhaustively on
   275	// core.OperationKind today (they walk only terminators); "handled" for these
   276	// two sites means the walk completes without error on a program containing
   277	// the kind, matching their current terminator-membership-test shape. Widening
   278	// them to a stronger, kind-aware notion of "handled" is D-04-29, out of this
   279	// plan's scope.
   280	func TestAllOperationKindsHandledAtEverySite(t *testing.T) {
   281		fixtures := []string{
   282			"testdata/phase1/toggle.lang",
   283			"testdata/phase1/comments.lang",
   284			"testdata/phase2/implicit_copy.lang",
   285			"testdata/phase2/owned_transfer.lang",
   286			"testdata/phase3/borrowed_view.lang",
   287			"testdata/phase3/branch_view.lang",
   288			"testdata/phase3/branch_one_arm_shared_accept.lang",
   289			"testdata/phase3/sequential_shared_then_exclusive_accept.lang",
   290			"testdata/phase3/shared_shared_accept.lang",
   291			"testdata/phase4/foreign_acquire_one.lang",
   292			"testdata/phase4/acquire_three_success.lang",
   293			"testdata/phase4/defect_terminal.lang",
   294		}
   295		encountered := make(map[core.OperationKind]bool)
   296		for _, path := range fixtures {
   297			source, err := os.ReadFile(testsupport.ProjectPath(splitPath(path)...))
   298			if err != nil {
   299				t.Fatalf("%s: read: %v", path, err)
   300			}
   301			checked := session.Check(source)
   302			if len(checked.Diagnostics) > 0 {
   303				t.Fatalf("%s: unexpected diagnostics: %v", path, checked.Diagnostics)
   304			}
   305			program := checked.Program
   306	
   307			// corevalidate site.
   308			validated := corevalidate.Validate(program)
   309			if !validated.Valid {
   310				t.Fatalf("%s: corevalidate rejected: %v", path, validated.Problems)
   311			}
   312			program = validated.Program()
   313	
   314			for _, function := range program.Functions {
   315				if function.Linear != nil {
   316					for _, operation := range function.Linear.Operations {
   317						encountered[operation.Kind] = true
   318					}
   319					// pathoracle site: must not error while walking.
   320					if function.Linear.ID != "" {
   321						if _, _, err := pathoracle.RecomputeEndpoints(function); err != nil {
   322							t.Fatalf("%s/%s: pathoracle error: %v", path, function.Name, err)
   323						}
   324					}
   325				}
   326				// originvalidate site: must not crash while walking.
   327				_ = originvalidate.RecomputeOriginPerReturn(function)
   328	
   329				// interp site.
   330				switch {
   331				case function.Match != nil:
   332					for _, arm := range function.Match.Arms {
   333						if _, err := interp.Run(program, function.Name, arm.Pattern); err != nil {
   334							t.Fatalf("%s/%s/%s: interp error: %v", path, function.Name, arm.Pattern, err)
   335						}
   336					}
   337				case function.Linear != nil:
   338					input, ok := linearProbeInput(function)
   339					if ok {
   340						if _, err := interp.Run(program, function.Name, input); err != nil {
   341							t.Fatalf("%s/%s: interp error: %v", path, function.Name, err)
   342						}
   343					}
   344				}
   345			}
   346	
   347			// cgen site: Emit requires exactly one function.
   348			if len(program.Functions) == 1 {
   349				if _, err := cgen.Emit(program); err != nil {
   350					t.Fatalf("%s: cgen error: %v", path, err)
   351				}
   352			}
   353		}
   354		for _, kind := range core.AllOperationKinds() {
   355			if !encountered[kind] {
   356				t.Fatalf("operation kind %q is never exercised by any corpus fixture in this control", kind)
   357			}
   358		}
   359	}
