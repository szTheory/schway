435:func ownedEvent(function core.Function, operation core.LinearOperation, kind string) Event {
     1	package interp
     2	
     3	import (
     4		"fmt"
     5	
     6		"github.com/codename-lang/lang/internal/compiler/core"
     7		"github.com/codename-lang/lang/internal/compiler/corevalidate"
     8		"github.com/codename-lang/lang/internal/compiler/execution"
