   255	func linearProbeInput(function core.Function) (string, bool) {
   256		switch function.Parameter.Type {
   257		case "Byte":
   258			return "7", true
   259		case "Buffer":
   260			return "01020304", true
   261		default:
   262			return "", false
   263		}
   264	}
