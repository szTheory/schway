   391	func runLinear(function core.Function, input string) (Execution, error) {
   392		// A straight-line body that carries Blocks/Edges is Phase 4's fallible-
   393		// call shape (D-04-04): the flat Operations list alone is not enough to
   394		// know which edge to follow, so it is walked block-by-block instead.
   395		// Every pre-Phase-4 linear (non-Match) function leaves Blocks empty --
   396		// only checkFallibleLinear ever populates it for a Match-less function --
   397		// so this branch changes nothing for any existing program.
   398		if len(function.Linear.Blocks) > 0 {
   399			return runLinearBlocks(function, input)
   400		}
   401		values := map[string]string{function.Parameter.ID: input}
   402		events := make([]Event, 0, len(function.Linear.Operations))
   403		for _, operation := range function.Linear.Operations {
   404			value, initialized := values[operation.SourceID]
   405			if !initialized {
   406				return Execution{}, fmt.Errorf("operation %q reads uninitialized place %q", operation.ID, operation.SourceID)
   407			}
   408			switch operation.Kind {
   409			case core.OpCopy:
   410				values[operation.TargetID] = value
   411				events = append(events, ownedEvent(function, operation, "value.copied"))
   412			case core.OpMove:
   413				delete(values, operation.SourceID)
   414				values[operation.TargetID] = value
   415				events = append(events, ownedEvent(function, operation, "value.transferred"))
   416			case core.OpBorrowShared:
   417				values[operation.TargetID] = value
   418				events = append(events, ownedEvent(function, operation, "value.borrowed"))
   419			case core.OpBorrowExclusive:
   420				values[operation.TargetID] = value
   421				events = append(events, ownedEvent(function, operation, "value.borrowed_exclusive"))
   422			case core.OpReturn:
   423				events = append(events, Event{
   424					Schema: execution.Schema1, ID: operation.ID + ":event:returned", Kind: "function.returned",
   425					FunctionID: function.ID, SourcePlace: operation.SourceID, TypeID: operation.TypeID,
   426				})
   427				return Execution{Schema: execution.Schema1, Outcome: Outcome{Kind: "returned", Value: value}, Events: events, LiveResources: []string{}}, nil
   428			default:
   429				return Execution{}, fmt.Errorf("operation %q has unknown kind %q", operation.ID, operation.Kind)
   430			}
   431		}
   432		return Execution{}, fmt.Errorf("linear body %q has no return operation", function.Linear.ID)
   433	}
