    26	
    27	type Repair struct {
    28		Kind   string `json:"kind"`
    29		Detail string `json:"detail,omitempty"`
    30		// Span, Replacement, and Applicability grow a Repair from a mere
    31		// classification into an applicable edit (D-06-24). All three are
    32		// deliberately NON-identity-bearing: see the repairKinds comment in
    33		// ErrorWithRepairs for why a coordinate shift must never move a
    34		// diagnostic's ID.
    35		Span          *Span  `json:"span,omitempty"`
    36		Replacement   string `json:"replacement,omitempty"`
    37		Applicability string `json:"applicability,omitempty"`
    38	}
    39	
    40	// The closed Applicability vocabulary (D-06-24), modeled on rustc's
    41	// Applicability enum. Only ApplicabilityMachineApplicable is driver-eligible;
    42	// everything else routes to the recorded, non-gating agent exercise
    43	// (D-06-23, D-06-30).
    44	const (
    45		ApplicabilityMachineApplicable    = "MachineApplicable"
    46		ApplicabilityRequiresConfirmation = "RequiresConfirmation"
    47		ApplicabilityUnspecified          = "Unspecified"
    48	)
    49	
    50	// Applicabilities returns the closed set of valid Repair.Applicability
    51	// values.
    52	func Applicabilities() []string {
    53		return []string{ApplicabilityMachineApplicable, ApplicabilityRequiresConfirmation, ApplicabilityUnspecified}
    54	}
    55	
    56	// ValidateRepair refuses any Applicability value outside the closed
    57	// vocabulary. An empty Applicability is treated as unset and is valid here;
    58	// callers that want the normalized value should use NormalizeApplicability.
    59	func ValidateRepair(r Repair) error {
    60		if r.Applicability == "" {
    61			return nil
    62		}
    63		for _, valid := range Applicabilities() {
    64			if r.Applicability == valid {
    65				return nil
    66			}
    67		}
    68		return fmt.Errorf("diagnostic: invalid repair applicability %q", r.Applicability)
    69	}
    70	
    71	// NormalizeApplicability maps an empty Applicability to
    72	// ApplicabilityUnspecified. It never defaults to ApplicabilityMachineApplicable:
    73	// defaulting toward driver-eligible is exactly the fail-open shape this
    74	// project refuses.
    75	func NormalizeApplicability(applicability string) string {
    76		if applicability == "" {
    77			return ApplicabilityUnspecified
    78		}
    79		return applicability
    80	}
    81	
    82	// DriverEligible reports whether a repair may be applied mechanically by the
    83	// repair driver (06-13). A repair is eligible only when it declares
    84	// MachineApplicable, carries both a span and replacement text to act on, AND
    85	// carries a non-empty Kind — a repair that claims machine-applicability
    86	// without the material to apply it, or without even naming what it is, is
    87	// not eligible; treating either as eligible would be the exact fail-open
    88	// shape this project refuses (D-06-27.2's structured-vocabulary-removal
    89	// guard depends on Kind mattering here, not merely as reporting metadata).
    90	// Everything not eligible (RequiresConfirmation, Unspecified, empty, or
    91	// incomplete MachineApplicable) routes to the recorded, non-gating agent
    92	// exercise (D-06-23, D-06-30).
    93	func DriverEligible(r Repair) bool {
    94		return r.Applicability == ApplicabilityMachineApplicable && r.Kind != "" && r.Span != nil && r.Replacement != ""
    95	}
    96	
    97	type Diagnostic struct {
    98		Schema   string   `json:"schema"`
    99		ID       string   `json:"id"`
   100		Code     string   `json:"code"`
   101		Severity string   `json:"severity"`
   102		Primary  Span     `json:"primary_span"`
   103		Message  string   `json:"message"`
   104		Causes   []Cause  `json:"causes,omitempty"`
   105		Repairs  []Repair `json:"repairs,omitempty"`
   106	}
   107	
   108	func Error(code string, span Span, message string, causes ...Cause) Diagnostic {
   109		identity := struct {
   110			Schema string
   111			Code   string
   112			Span   Span
   113			Causes []Cause
   114		}{Schema: Schema, Code: code, Span: span, Causes: causes}
   115		encoded, _ := json.Marshal(identity)
   116		sum := sha256.Sum256(encoded)
   117		return Diagnostic{Schema: Schema, ID: "diagnostic:" + hex.EncodeToString(sum[:12]), Code: code, Severity: "error", Primary: span, Message: message, Causes: causes}
   118	}
   119	
   120	// ErrorWithRepairs constructs the feature-specific diagnostic/1 record used by
   121	// ownership checking. Repair order is canonical, and only repair kinds—not
   122	// display detail or message prose—participate in semantic identity.
   123	func ErrorWithRepairs(code string, span Span, message string, causes []Cause, repairs ...Repair) Diagnostic {
   124		repairs = append([]Repair(nil), repairs...)
   125		sort.Slice(repairs, func(left, right int) bool {
   126			if repairs[left].Kind == repairs[right].Kind {
   127				return repairs[left].Detail < repairs[right].Detail
   128			}
   129			return repairs[left].Kind < repairs[right].Kind
   130		})
   131		// Span, Replacement, and Applicability are deliberately excluded from
   132		// repairKinds: a coordinate shift (an edit to a line above this
   133		// diagnostic) must never change a diagnostic's published ID (D-06-24).
   134		// Only Kind participates in semantic identity.
   135		repairKinds := make([]string, len(repairs))
   136		for index, repair := range repairs {
   137			repairKinds[index] = repair.Kind
   138		}
   139		identity := struct {
   140			Schema      string
   141			Code        string
   142			Span        Span
   143			Causes      []Cause
   144			RepairKinds []string
   145		}{Schema: Schema1, Code: code, Span: span, Causes: causes, RepairKinds: repairKinds}
   146		encoded, _ := json.Marshal(identity)
   147		sum := sha256.Sum256(encoded)
   148		return Diagnostic{
   149			Schema: Schema1, ID: "diagnostic:" + hex.EncodeToString(sum[:12]), Code: code,
   150			Severity: "error", Primary: span, Message: message, Causes: causes, Repairs: repairs,
   151		}
   152	}
   153	
   154	func (d Diagnostic) String() string {
   155		return fmt.Sprintf("%s [%d:%d]: %s", d.Code, d.Primary.Start, d.Primary.End, d.Message)
   156	}
