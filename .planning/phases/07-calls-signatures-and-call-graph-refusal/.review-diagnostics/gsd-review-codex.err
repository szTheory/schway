  1788	
  1789	// D-05-35(d): computeLoanLastUses (loanLivenessFixpoint's own last-use
  1790	// derivation) is now the sole law deciding conflict/expiry here --
  1791	// discoverLoanLastUses is retired, authorized by D-05-35(b)/(c)'s recorded
  1792	// zero-divergence shadow run over the full TestOwnershipSequenceExhaustive/
  1793	// TestBranchSequenceExhaustive enumeration.
  1794	//
  1795	// The discoveryWork term folded into result.Work below is deliberately kept
  1796	// as the historical flat len(body.Bindings)+1 accounting convention (not
  1797	// computeLoanLastUses' own fixpoint.work, which varies with loan-chain shape)
  1798	// -- TestOwnershipSequenceExhaustive/TestOwnershipWorkSeries pin this exact
  1799	// field against an independent oracle/hand-derived formula that predates
  1800	// D-05-35 and has no way to reproduce loanLivenessFixpoint's own internal
  1801	// cost shape. The fixpoint's REAL, honestly-varying cost is not hidden: it is
  1802	// counted separately via FixpointWork (see its own doc comment), folded into
  1803	// checkLinear's function-level RecomputedWork total.
  1804	func analyzeStraightLine(functionID, parameterName string, parameterSpan diagnostic.Span, typeFact core.TypeFact, body *ast.LinearBody) ownershipSupport {
  1805		parameterID := functionID + ":place:0"
  1806		result := ownershipSupport{
  1807			Places:     []core.Place{{ID: parameterID, Name: parameterName, TypeID: typeFact.ID}},
  1808			Operations: []core.LinearOperation{}, LoanFinalUses: []loanFinalUseFact{}, States: []ownershipStateFact{},
  1809			Work: typeNodeCount(typeFact.Shape) + len(body.Bindings) + 1,
  1810		}
  1811		loanUses, fixpointWork := computeLoanLastUses(parameterName, body)
  1812		result.FixpointWork = fixpointWork
  1813		result.Work += len(body.Bindings) + 1
  1814		for index, binding := range body.Bindings {
  1815			if binding.RHS.Kind == "borrow" || binding.RHS.Kind == "borrow_mut" {
  1816				result.LoanFinalUses = append(result.LoanFinalUses, loanFinalUseFact{
  1817					LoanID: fmt.Sprintf("%s:loan:%d", functionID, index), Binding: binding.Name, OperationIndex: loanUses[index].index,
  1818				})
  1819			}
  1820		}
  1821		places := map[string]*placeState{
  1822			parameterName: {place: result.Places[0], declared: parameterSpan, initialized: true},
  1823		}
  1824		activeLoans := make(map[string]map[string]*loanState)
  1825		expiringLoans := make(map[int][]*loanState)
  1826		endLoans := func(index int) {
  1827			for _, loan := range expiringLoans[index] {
  1828				if loans := activeLoans[loan.ownerID]; loans != nil {
  1829					delete(loans, loan.id)
  1830					if len(loans) == 0 {
  1831						delete(activeLoans, loan.ownerID)
  1832					}
  1833				}
  1834			}
  1835		}
  1836		fail := func(problem diagnostic.Diagnostic) ownershipSupport {
  1837			result.DiagnosticCode = problem.Code
  1838			result.Diagnostic = &problem
  1839			return result
  1840		}
  1841		useAfterMove := func(span diagnostic.Span, state *placeState) diagnostic.Diagnostic {
  1842			causes := []diagnostic.Cause{
  1843				{Kind: "declared_here", Span: spanPointer(state.declared)},
  1844				{Kind: "moved_here", Span: state.movedAt},
  1845				{Kind: "place", Detail: state.place.ID},
  1846				{Kind: "transfer_target", Detail: state.moveTargetID},
  1847				{Kind: "type", Detail: state.place.TypeID},
  1848			}
  1849			// repairSpan is a copy of span (the exact identifier text that named
  1850			// the already-moved place), never a pointer aliasing the caller's own
  1851			// span value. Replacement is the moved-to binding's surface name
  1852			// (moveTargetName), the source-level counterpart of moveTargetID:
  1853			// swapping the stale name for the live one is the mechanical fix a
  1854			// use-after-move repair applies (D-06-24/D-06-25's move injector).
  1855			// moveTargetName is only ever unset if moveTargetID is also unset,
  1856			// in which case Replacement stays "" and DriverEligible is false by
  1857			// construction — fail-closed, no explicit guard needed.
  1858			repairSpan := span
  1859			return diagnostic.ErrorWithRepairs(
  1860				"ownership.use_after_move", span, "value was used after ownership transferred", causes,
  1861				diagnostic.Repair{
  1862					Kind:          "use_transfer_target",
  1863					Detail:        state.moveTargetID,
  1864					Span:          &repairSpan,
  1865					Replacement:   state.moveTargetName,
  1866					Applicability: diagnostic.ApplicabilityMachineApplicable,
  1867				},
  1868				diagnostic.Repair{Kind: "move_use_before_transfer"},
  1869			)
  1870		}
  1871		for index, binding := range body.Bindings {
  1872			result.Work++
  1873			source, ok := places[binding.RHS.Source]
  1874			if !ok {
  1875				return fail(diagnostic.Error("name.unknown", binding.RHS.Span, "binding source is unknown"))
  1876			}
  1877			if !source.initialized {
  1878				return fail(useAfterMove(binding.RHS.Span, source))
  1879			}
  1880			target := core.Place{ID: fmt.Sprintf("%s:place:%d", functionID, index+1), Name: binding.Name, TypeID: source.place.TypeID}
  1881			kind := core.OpCopy
  1882			var loan *loanState
  1883			switch binding.RHS.Kind {
  1884			case "take":
  1885				if loans := activeLoans[source.place.ID]; len(loans) > 0 {
  1886					loanIDs := make([]string, 0, len(loans))
  1887					for loanID := range loans {
  1888						loanIDs = append(loanIDs, loanID)
  1889					}
  1890					sort.Strings(loanIDs)
  1891					blocking := loans[loanIDs[0]]
  1892					causes := []diagnostic.Cause{
  1893						{Kind: "borrow_created_here", Span: spanPointer(blocking.borrowedAt)},
  1894						{Kind: "borrow_used_later", Span: spanPointer(blocking.lastUseSpan)},
  1895						{Kind: "loan", Detail: blocking.id},
  1896						{Kind: "owner", Detail: source.place.ID},
  1897						{Kind: "type", Detail: source.place.TypeID},
  1898					}
  1899					return fail(diagnostic.ErrorWithRepairs(
  1900						"ownership.move_while_borrowed", binding.RHS.Span, "cannot transfer ownership while a future-used shared loan is live", causes,
  1901						diagnostic.Repair{Kind: "move_after_last_borrow_use"},
  1902					))
  1903				}
  1904				kind = core.OpMove
  1905				source.initialized = false
  1906				source.movedAt = spanPointer(binding.RHS.Span)
  1907				source.moveTargetID = target.ID
  1908				source.moveTargetName = target.Name
  1909			case "borrow":
  1910				// A shared loan requires the share ability, exactly as the
  1911				// implicit-copy path below requires copy. Without this gate the
  1912				// checker emits core.OpBorrowShared that the source-blind
  1913				// validator rejects as core.ability.share_denied, turning an
  1914				// invalid program into a spanless operational failure.
  1915				if !hasTypeAbility(typeFact, core.AbilityShare) {
  1916					causes := []diagnostic.Cause{
  1917						{Kind: "declared_here", Span: spanPointer(source.declared)},
  1918						{Kind: "missing_ability", Detail: missingAbilityDetail(typeFact, core.AbilityShare)},
  1919						{Kind: "place", Detail: source.place.ID},
  1920						{Kind: "type", Detail: source.place.TypeID},
  1921					}
  1922					return fail(diagnostic.ErrorWithRepairs(
  1923						"ownership.borrow_requires_share", binding.RHS.Span, "type does not grant the share ability required to borrow", causes,
  1924						diagnostic.Repair{Kind: "use_take_instead"},
  1925					))
  1550		}
  1551		for _, lane := range result.Lanes {
  1552			if lane.RecomputedWork == 0 {
  1553				return fail(protocol.StatusInvalid, "verify.zero_work", lane.ID)
  1554			}
  1555		}
  1556		result.Metrics.ElapsedNS = time.Since(started).Nanoseconds()
  1557		return result.Finalize()
  1558	}
  1559	
  1560	// verifyBorrowedCorpus is the Phase 3 verify path (Task 03-07-02): it
  1561	// dispatches when borrowed_view.lang is present, before the Phase 2 probe is
  1562	// considered (VerifyCorpus checks this corpus's own dispatch file first).
  1563	// Every lane uses the Phase 1 addLane shape (an explicit status on every
  1564	// path, PATTERNS I-1), so a failing lane is still returned rather than
  1565	// silently dropped the way Phase 2's verifyOwnedCorpus would drop one.
  1566	func verifyBorrowedCorpus(ctx context.Context, corpus string, runner native.Runner) protocol.Result {
  1567		started := time.Now()
  1568		result := protocol.New("verify", protocol.StatusPass)
  1569		result.ExpectedEscapes = append([]string{corevalidate.KnownEscape}, originvalidate.ExpectedEscapes()...)
  1570		addLane := func(id, status string, controls []string, work, outputBytes int, laneStarted time.Time) {
  1571			result.Lanes = append(result.Lanes, protocol.Lane{
  1572				Schema: protocol.LaneSchema1, ID: id, Status: status,
  1573				Controls: append([]string{}, controls...), RecomputedWork: work,
  1574				ElapsedNS: time.Since(laneStarted).Nanoseconds(), PeakRSSStatus: protocol.PeakRSSUnavailable, OutputBytes: outputBytes,
  1575			})
  1576			result.Metrics.RecomputedWork += work
  1577			result.Metrics.OutputBytes += outputBytes
  1578		}
  1579		fail := func(status, code, message string) protocol.Result {
  1580			result.Status = status
  1581			result.Diagnostics = append(result.Diagnostics, diagnostic.Error(code, diagnostic.Span{}, message))
  1582			result.Metrics.ElapsedNS = time.Since(started).Nanoseconds()
  1583			return result.Finalize()
  1584		}
  1585	
  1586		// Lane 1: exclusive-conflict, exclusive-move negative controls.
  1587		laneStarted := time.Now()
  1588		exclusiveControls := []struct{ file, code, control string }{
  1589			{"exclusive_exclusive_reject.lang", "ownership.borrow_conflict", "control:ownership.exclusive_conflict"},
  1590			{"exclusive_move_reject.lang", "ownership.move_while_borrowed", "control:ownership.exclusive_move"},
  1591		}
  1592		exclusiveControlNames := make([]string, 0, len(exclusiveControls))
  1593		for _, control := range exclusiveControls {
  1594			exclusiveControlNames = append(exclusiveControlNames, control.control)
  1595		}
  1596		exclusiveBytes := 0
  1597		for _, control := range exclusiveControls {
  1598			source, err := readBoundedFile(filepath.Join(corpus, control.file), syntax.MaxSourceBytes)
  1599			if err != nil {
  1600				addLane("lane:borrowed-negative-controls", "fail", nil, exclusiveBytes+1, exclusiveBytes, laneStarted)
  1601				return fail(protocol.StatusOperational, "verify.fixture_missing", control.file)
  1602			}
  1603			if len(source) > syntax.MaxSourceBytes {
  1604				return fail(protocol.StatusInvalid, "verify.fixture_input_limit", control.file)
  1605			}
  1606			exclusiveBytes += len(source)
  1607			checked := Check(source)
  1608			if len(checked.Diagnostics) != 1 || checked.Diagnostics[0].Code != control.code {
  1609				addLane("lane:borrowed-negative-controls", "fail", nil, exclusiveBytes, exclusiveBytes, laneStarted)
  1610				return fail(protocol.StatusInvalid, "verify.control_missing", control.control)
  1611			}
  1612		}
  1613		addLane("lane:borrowed-negative-controls", "pass", exclusiveControlNames, len(exclusiveControls), exclusiveBytes, laneStarted)
  1614	
  1615		// Lane 2 + 3: CFG-liveness controls, reusing the already-proven,
  1616		// independently-tested lane constructors (03-04, 03-05) rather than
  1617		// duplicating their mutation logic here.
  1618		branchSource, err := readBoundedFile(filepath.Join(corpus, "borrowed_view.lang"), syntax.MaxSourceBytes)
  1619		if err != nil {
  1620			return fail(protocol.StatusOperational, "verify.fixture_missing", "borrowed_view.lang")
  1621		}
  1622		if len(branchSource) > syntax.MaxSourceBytes {
  1623			return fail(protocol.StatusInvalid, "verify.fixture_input_limit", "borrowed_view.lang")
  1624		}
  1625		branchChecked := Check(branchSource)
  1626		if len(branchChecked.Diagnostics) != 0 || len(branchChecked.Program.Functions) != 1 {
  1627			return fail(protocol.StatusInvalid, "verify.borrowed_invalid", "borrowed view fixture is invalid")
  1628		}
  1629		branchValidated := corevalidate.Validate(branchChecked.Program)
  1630		if !branchValidated.Valid {
  1631			return fail(protocol.StatusInvalid, "verify.borrowed_invalid", "borrowed view fixture failed independent validation")
  1632		}
  1633		honestBranch := branchValidated.Program()
  1634	
  1635		endpointLane := BorrowedLoanEndpointControlLane(honestBranch)
  1636		result.Lanes = append(result.Lanes, endpointLane)
  1637		result.Metrics.RecomputedWork += endpointLane.RecomputedWork
  1638		result.Metrics.OutputBytes += endpointLane.OutputBytes
  1639		if endpointLane.Status != "pass" {
  1640			return fail(protocol.StatusInvalid, "verify.control_missing", "control:core.loan_endpoint_mismatch")
  1641		}
  1642	
  1643		oracleLane := PathOracleDisagreementLane(honestBranch)
  1644		result.Lanes = append(result.Lanes, oracleLane)
  1645		result.Metrics.RecomputedWork += oracleLane.RecomputedWork
  1646		result.Metrics.OutputBytes += oracleLane.OutputBytes
  1647		if oracleLane.Status != "pass" {
  1648			return fail(protocol.StatusInvalid, "verify.control_missing", "control:cfg.path_oracle_disagreement")
  1649		}
  1650	
  1651		// Lane 4: the three OWN-04 origin controls (understated, impossible,
  1652		// stale-summary), mutating honestly-checked public_view* fixtures the
  1653		// same way originvalidate's own falsifiers do (check.go's honest
  1654		// producer can never construct any of the three dishonest shapes
  1655		// itself, per D-09's mutation-kill precedent).
  1656		laneStarted = time.Now()
  1657		originWork := 0
  1658		originBytes := 0
  1659	
  1660		understated, err := readBoundedFile(filepath.Join(corpus, "public_view_understated.lang"), syntax.MaxSourceBytes)
  1661		if err != nil {
  1662			addLane("lane:borrowed-origin-controls", "fail", nil, originWork+1, originBytes, laneStarted)
  1663			return fail(protocol.StatusOperational, "verify.fixture_missing", "public_view_understated.lang")
  1664		}
  1665		originBytes += len(understated)
  1666		understatedChecked := Check(understated)
  1667		if len(understatedChecked.Diagnostics) != 0 || len(understatedChecked.Program.Functions) != 1 || understatedChecked.Program.Functions[0].PublicOrigin == nil {
  1668			addLane("lane:borrowed-origin-controls", "fail", nil, originWork+1, originBytes, laneStarted)
  1669			return fail(protocol.StatusInvalid, "verify.borrowed_invalid", "understated origin fixture is invalid")
  1670		}
  1671		understatedProgram := understatedChecked.Program
  1672		understatedProgram.Functions[0].PublicOrigin = &core.PublicOrigin{Paths: []string{}, Access: understatedProgram.Functions[0].PublicOrigin.Access}
  1673		originWork++
  1674		if problems := originvalidate.ValidatePublished(understatedProgram); len(problems) != 1 || problems[0].Code != "core.origin_understated" {
  1675			addLane("lane:borrowed-origin-controls", "fail", nil, originWork, originBytes, laneStarted)
  1676			return fail(protocol.StatusInvalid, "verify.control_missing", "control:origin.understated_summary")
  1677		}
  1678	
  1679		impossible, err := readBoundedFile(filepath.Join(corpus, "public_view_impossible.lang"), syntax.MaxSourceBytes)
  1680		if err != nil {
  1681			addLane("lane:borrowed-origin-controls", "fail", nil, originWork+1, originBytes, laneStarted)
  1682			return fail(protocol.StatusOperational, "verify.fixture_missing", "public_view_impossible.lang")
  1683		}
  1684		originBytes += len(impossible)
  1685		impossibleChecked := Check(impossible)
  1686		if len(impossibleChecked.Diagnostics) != 0 || len(impossibleChecked.Program.Functions) != 1 || impossibleChecked.Program.Functions[0].PublicOrigin == nil {
  1687			addLane("lane:borrowed-origin-controls", "fail", nil, originWork+1, originBytes, laneStarted)
  1688			return fail(protocol.StatusInvalid, "verify.borrowed_invalid", "impossible access fixture is invalid")
  1689		}
  1690		impossibleProgram := impossibleChecked.Program
  1691		impossibleProgram.Functions[0].PublicOrigin = &core.PublicOrigin{Paths: impossibleProgram.Functions[0].PublicOrigin.Paths, Access: "exclusive"}
  1692		originWork++
  1693		if problems := originvalidate.ValidatePublished(impossibleProgram); len(problems) != 1 || problems[0].Code != "core.origin_access_mismatch" {
  1694			addLane("lane:borrowed-origin-controls", "fail", nil, originWork, originBytes, laneStarted)
  1695			return fail(protocol.StatusInvalid, "verify.control_missing", "control:origin.impossible_summary")
  1696		}
  1697	
  1698		honestView, err := readBoundedFile(filepath.Join(corpus, "public_view.lang"), syntax.MaxSourceBytes)
  1699		if err != nil {
  1700			addLane("lane:borrowed-origin-controls", "fail", nil, originWork+1, originBytes, laneStarted)
  1701			return fail(protocol.StatusOperational, "verify.fixture_missing", "public_view.lang")
  1702		}
  1703		originBytes += len(honestView)
  1704		honestViewChecked := Check(honestView)
  1705		if len(honestViewChecked.Diagnostics) != 0 || len(honestViewChecked.Program.Functions) != 1 {
  1706			addLane("lane:borrowed-origin-controls", "fail", nil, originWork+1, originBytes, laneStarted)
  1707			return fail(protocol.StatusInvalid, "verify.borrowed_invalid", "public view fixture is invalid")
  1708		}
  1709		summary, err := originvalidate.BuildInterface(honestViewChecked.Program)
  1710		if err != nil {
  1711			return fail(protocol.StatusOperational, "verify.evidence_build_failed", "unable to build interface summary")
  1712		}
  1713		summaryBytes, err := json.Marshal(summary)
  1714		if err != nil {
  1715			return fail(protocol.StatusOperational, "verify.evidence_build_failed", "unable to marshal interface summary")
  1716		}
  1717		realCoreBytes, err := json.Marshal(honestViewChecked.Program)
  1718		if err != nil {
  1719			return fail(protocol.StatusOperational, "verify.evidence_build_failed", "unable to marshal core artifact")
  1720		}
  1721		staleCoreBytes := append(append([]byte(nil), realCoreBytes...), '/', '/', 's', 't', 'a', 'l', 'e')
  1722		originWork++
  1723		if _, checkErr := originvalidate.CheckSummary(summaryBytes, staleCoreBytes); checkErr == nil {
  1724			addLane("lane:borrowed-origin-controls", "fail", nil, originWork, originBytes, laneStarted)
  1725			return fail(protocol.StatusInvalid, "verify.control_missing", "control:origin.stale_summary")
  1726		} else {
  1727			var originError *originvalidate.Error
  1728			if !errors.As(checkErr, &originError) || originError.Code != "origin.stale_summary" {
  1729				addLane("lane:borrowed-origin-controls", "fail", nil, originWork, originBytes, laneStarted)
  1730				return fail(protocol.StatusInvalid, "verify.control_missing", "control:origin.stale_summary")
  1731			}
  1732		}
  1733	
  1734		omitted, err := readBoundedFile(filepath.Join(corpus, "public_view_omitted.lang"), syntax.MaxSourceBytes)
  1735		if err != nil {
  1736			addLane("lane:borrowed-origin-controls", "fail", nil, originWork+1, originBytes, laneStarted)
  1737			return fail(protocol.StatusOperational, "verify.fixture_missing", "public_view_omitted.lang")
  1738		}
  1739		originBytes += len(omitted)
  1740		omittedChecked := Check(omitted)
  1741		if len(omittedChecked.Diagnostics) != 0 || len(omittedChecked.Program.Functions) != 1 {
  1742			addLane("lane:borrowed-origin-controls", "fail", nil, originWork+1, originBytes, laneStarted)
  1743			return fail(protocol.StatusInvalid, "verify.borrowed_invalid", "omitted origin fixture is invalid")
  1744		}
  1745		originWork++
  1746		if problems := originvalidate.ValidatePublished(omittedChecked.Program); len(problems) != 1 || problems[0].Code != "core.origin_omitted" {
  1747			addLane("lane:borrowed-origin-controls", "fail", nil, originWork, originBytes, laneStarted)
  1748			return fail(protocol.StatusInvalid, "verify.control_missing", "control:origin.omitted_summary")
  1749		}
  1750	
  1751		// control:origin.mixed_access_chain needs no mutation injection, unlike
  1752		// the understated and impossible controls above: check.go's honest
  1753		// producer constructs the mismatching declaration itself (a mixed
  1754		// shared/exclusive reborrow chain whose declared access the body cannot
  1755		// support), which is precisely why the defect reached the shipped
  1756		// binary (03-REVIEW.md CR-01, closed by 03-08).
  1757		mixedAccess, err := readBoundedFile(filepath.Join(corpus, "public_view_mixed_access.lang"), syntax.MaxSourceBytes)
  1758		if err != nil {
  1759			addLane("lane:borrowed-origin-controls", "fail", nil, originWork+1, originBytes, laneStarted)
  1760			return fail(protocol.StatusOperational, "verify.fixture_missing", "public_view_mixed_access.lang")
  1761		}
  1762		originBytes += len(mixedAccess)
  1763		mixedAccessChecked := Check(mixedAccess)
  1764		if len(mixedAccessChecked.Diagnostics) != 0 || len(mixedAccessChecked.Program.Functions) != 1 {
  1765			addLane("lane:borrowed-origin-controls", "fail", nil, originWork+1, originBytes, laneStarted)
  1766			return fail(protocol.StatusInvalid, "verify.borrowed_invalid", "mixed access chain fixture is invalid")
  1767		}
  1768		originWork++
  1769		if problems := originvalidate.ValidatePublished(mixedAccessChecked.Program); len(problems) != 1 || problems[0].Code != "core.origin_access_mismatch" {
  1770			addLane("lane:borrowed-origin-controls", "fail", nil, originWork, originBytes, laneStarted)
  1771			return fail(protocol.StatusInvalid, "verify.control_missing", "control:origin.mixed_access_chain")
  1772		}
  1773	
  1774		// control:origin.multi_arm_omitted (Task 03-10-03, closing
  1775		// 03-VERIFICATION.md's SC3/SC4 multi-arm gap): like
   220	// returns an owned take).
   221	func TestOwnedReturnWithNoOriginStillPublishes(t *testing.T) {
   222		for _, fixture := range []string{"shared_shared_accept.lang", "borrowed_view.lang"} {
   223			program := honestOmittedProgram(t, fixture)
   224			if problems := originvalidate.ValidatePublished(program); len(problems) != 0 {
   225				t.Fatalf("%s: expected no problems for an owned return with no declared origin, got %+v", fixture, problems)
   226			}
   227		}
   228	}
   229	
   230	// TestExclusiveBorrowCleanShapeChecksButCannotPublish is 03-09-01's
   231	// falsifier for the fixture_disposition: session.Check on the exact
   232	// exclusive_borrow_clean / relay source (embedded verbatim from
   233	// check_exclusive_test.go, so the disposition is machine-checked rather
   234	// than asserted in prose) still returns zero diagnostics, while
   235	// ValidatePublished on that same checked program now returns
   236	// core.origin_omitted — the gate lives on the publication path only.
   237	func TestExclusiveBorrowCleanShapeChecksButCannotPublish(t *testing.T) {
   238		const cleanSource = `module owned.exclusive_borrow_clean
   239	
   240	export {
   241	  fn relay
   242	}
   243	
   244	fn relay(buffer: Buffer) -> Buffer {
   245	  let view = borrow mut buffer
   246	  let reviewed = borrow view
   247	  view
   248	}
   249	`
   250		checked := session.Check([]byte(cleanSource))
   251		if len(checked.Diagnostics) != 0 {
   252			t.Fatalf("expected session.Check to still accept the exclusive_borrow_clean shape unchanged, got %+v", checked.Diagnostics)
   253		}
   254		problems := originvalidate.ValidatePublished(checked.Program)
   255		if len(problems) != 1 || problems[0].Code != "core.origin_omitted" {
   256			t.Fatalf("expected exactly core.origin_omitted on the publication path, got %+v", problems)
   257		}
   258	}
   259	
   260	// honestOmittedProgram is like honestProgram but does NOT assert a non-nil
   261	// PublicOrigin — it is used for fixtures that deliberately declare none
   262	// (public_view_omitted.lang) or whose shape never carries one
   263	// (match-bodied borrowed_view.lang).
   264	func honestOmittedProgram(t testing.TB, fixture string) core.Program {
   265		t.Helper()
   266		source, err := os.ReadFile(testsupport.ProjectPath("testdata", "phase3", fixture))
   267		if err != nil {
   268			t.Fatal(err)
   269		}
   270		checked := session.Check(source)
   271		if len(checked.Diagnostics) != 0 {
   272			t.Fatalf("unexpected diagnostics: %+v", checked.Diagnostics)
   273		}
   274		return checked.Program
   275	}

