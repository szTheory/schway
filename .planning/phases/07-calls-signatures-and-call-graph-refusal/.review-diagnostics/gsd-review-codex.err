  2529			fixtureValidated := corevalidate.Validate(fixtureChecked.Program)
  2530			if !fixtureValidated.Valid {
  2531				addLane("lane:kind-exhaustive-dispatch", "fail", nil, dispatchWork+fixtureValidated.Checks, len(fixtureSource), laneStarted)
  2532				return fail(protocol.StatusInvalid, "verify.fixture_rejected", fixtureName)
  2533			}
  2534			dispatchWork += fixtureValidated.Checks
  2535			dispatchProgram := fixtureValidated.Program()
  2536			for _, function := range dispatchProgram.Functions {
  2537				if function.Linear != nil {
  2538					for _, operation := range function.Linear.Operations {
  2539						encounteredKinds[operation.Kind] = true
  2540					}
  2541					if function.Linear.ID != "" {
  2542						if _, _, oracleErr := pathoracle.RecomputeEndpoints(function); oracleErr != nil {
  2543							addLane("lane:kind-exhaustive-dispatch", "fail", nil, dispatchWork+1, len(fixtureSource), laneStarted)
  2544							return fail(protocol.StatusOperational, "verify.control_incomplete", "pathoracle dispatch error for "+fixtureName)
  2545						}
  2546					}
  2547				}
  2548				_ = originvalidate.RecomputeOriginPerReturn(function)
  2549				dispatchWork++
  2550				if function.Match != nil {
  2551					for _, arm := range function.Match.Arms {
  2552						if _, interpErr := interp.Run(dispatchProgram, function.Name, arm.Pattern); interpErr != nil {
  2553							addLane("lane:kind-exhaustive-dispatch", "fail", nil, dispatchWork+1, len(fixtureSource), laneStarted)
  2554							return fail(protocol.StatusOperational, "verify.control_incomplete", "interp dispatch error for "+fixtureName)
  2555						}
  2556						dispatchWork++
  2557					}
  2558				}
  2559			}
  2560			if len(dispatchProgram.Functions) == 1 {
  2561				if _, cgenErr := cgen.Emit(dispatchProgram); cgenErr != nil {
  2562					addLane("lane:kind-exhaustive-dispatch", "fail", nil, dispatchWork+1, len(fixtureSource), laneStarted)
  2563					return fail(protocol.StatusOperational, "verify.control_incomplete", "cgen dispatch error for "+fixtureName)
  2564				}
  2565				dispatchWork++
  2566			}
  2567		}
  2568		for _, kind := range []core.OperationKind{core.OpForeignCall, core.OpRelease, core.OpFail, core.OpDefect} {
  2569			if !encounteredKinds[kind] {
  2570				addLane("lane:kind-exhaustive-dispatch", "fail", nil, dispatchWork+1, 0, laneStarted)
  2571				return fail(protocol.StatusInvalid, "verify.control_missing", "control:kind.exhaustive_dispatch (kind "+string(kind)+" never encountered)")
  2572			}
  2573		}
  2574		addLane("lane:kind-exhaustive-dispatch", "pass", []string{"control:kind.exhaustive_dispatch"}, dispatchWork+1, 0, laneStarted)
  2575	
  2576		requiredControls := append(append([]string(nil), Phase4RequiredControls()...), "control:defect.signal_adjudicated")
  2577		for _, required := range requiredControls {
  2578			if !hasControl(result.Lanes, required) {
