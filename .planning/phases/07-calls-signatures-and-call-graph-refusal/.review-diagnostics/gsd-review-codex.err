  2493		}
  2494		foreignOriginProblems := originvalidate.ValidatePublished(foreignOriginChecked.Program)
  2495		if len(foreignOriginProblems) != 1 || foreignOriginProblems[0].Code != "core.foreign_origin_omitted" {
  2496			addLane("lane:foreign-origin-omitted", "fail", nil, foreignOriginChecked.Work+1, len(foreignOriginSource), laneStarted)
  2497			return fail(protocol.StatusInvalid, "verify.control_missing", "control:origin.foreign_origin_omitted")
  2498		}
  2499		addLane("lane:foreign-origin-omitted", "pass", []string{"control:origin.foreign_origin_omitted"}, foreignOriginChecked.Work+1, len(foreignOriginSource), laneStarted)
  2500	
  2501		// Lane: control:kind.exhaustive_dispatch (D-04-22, task 04-07-01). This is
  2502		// the session-layer, CLI-observable sibling of core_test.go's
  2503		// TestAllOperationKindsHandledAtEverySite, which proves dispatch
  2504		// completeness in-process across all four phases' corpora combined; this
  2505		// lane proves the same claim is visible through `lang verify
  2506		// testdata/phase4` itself, scoped to the four operation kinds THIS phase
  2507		// introduced (OpForeignCall, OpRelease, OpFail, OpDefect) -- the kinds
  2508		// Phase 1-3's own corpora cannot exercise, so this corpus is the only
  2509		// place their dispatch completeness can be demonstrated through the
  2510		// shipped binary. It drives every dispatch-fixture already read above
  2511		// through corevalidate, pathoracle, originvalidate, interp, and cgen, and
  2512		// requires all four kinds to be encountered by at least one operation.
  2513		laneStarted = time.Now()
  2514		dispatchFixtures := []string{"foreign_acquire_one.lang", "acquire_three_success.lang", "defect_terminal.lang", "nonlocal_exit_probe.lang"}
  2515		encounteredKinds := make(map[core.OperationKind]bool)
  2516		dispatchWork := 0
  2517		for _, fixtureName := range dispatchFixtures {
  2518			fixtureSource, fixtureErr := readBoundedFile(filepath.Join(corpus, fixtureName), syntax.MaxSourceBytes)
  2519			if fixtureErr != nil {
  2520				addLane("lane:kind-exhaustive-dispatch", "fail", nil, dispatchWork+1, 0, laneStarted)
  2521				return fail(protocol.StatusOperational, "verify.fixture_missing", fixtureName)
  2522			}
  2523			fixtureChecked := Check(fixtureSource)
  2524			if len(fixtureChecked.Diagnostics) != 0 {
  2525				addLane("lane:kind-exhaustive-dispatch", "fail", nil, dispatchWork+1, len(fixtureSource), laneStarted)
  2526				return fail(protocol.StatusInvalid, "verify.fixture_rejected", fixtureName)
  2527			}
