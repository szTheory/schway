   122				// cross-lock (03-PATTERNS I-7): linear-only requires /1,
   123				// match-only requires /0, match-with-arm-bodies also requires
   124				// /1.
   125				if !v.check(v.program.Schema == core.Schema1, "core.schema", "a match with an arm body requires lang.core/1") || !v.matchBranch(function, dataNames) {
   126					return
   127				}
   128			case function.Linear != nil:
   129				if !v.check(v.program.Schema == core.Schema1, "core.schema", "linear body requires lang.core/1") || !v.linear(function) {
   130					return
   820					ID:     fmt.Sprintf("%s:point:%s:%d:%s", function.ID, block.ID, birth.ordinal, loanID),
   821					LoanID: loanID, Kind: "point", BlockID: block.ID, AfterOperationID: birth.opID,
   822				})
   823			}
   824		}
   825		sort.Slice(endpoints, func(i, j int) bool { return endpoints[i].ID < endpoints[j].ID })
   826		return endpoints
   827	}
